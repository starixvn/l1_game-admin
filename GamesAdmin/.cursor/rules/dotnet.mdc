```csharp
// Use try-catch for expected exceptions
try
{
    var result = await service.ProcessAsync(request);
    return result;
}
catch (ValidationException ex)
{
    // Handle validation errors
    return BadRequest(ex.Message);
}
catch (Exception ex)
{
    // Log unexpected errors
    logger.LogError(ex, "Unexpected error processing request");
    return StatusCode(500, "Internal server error");
}
```

#### Validation Patterns

```csharp
// Use data annotations for model validation
public class CreateGameRequest
{
    [Required]
    [StringLength(100)]
    public string Name { get; set; }

    [Range(1, 100)]
    public int GameType { get; set; }
}

// Use fluent validation for complex rules
public class GameValidator : AbstractValidator<CreateGameRequest>
{
    public GameValidator()
    {
        RuleFor(x => x.Name).NotEmpty().WithMessage("Name is required");
        RuleFor(x => x.GameType).GreaterThan(0).WithMessage("Invalid game type");
    }
}
```

