{
  "compileOnSave": true,
  "compilerOptions": {
    "moduleResolution": "node",
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es5",
    "outDir": "wwwroot/js",
    "typeRoots": [ "wwwroot/lib/types", "node_modules" ]
  },
  "exclude": [
    "node_modules",
    "wwwroot"
  ]
}
