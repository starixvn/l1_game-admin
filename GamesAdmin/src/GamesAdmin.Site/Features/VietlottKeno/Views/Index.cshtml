@model GamesAdmin.Site.Features.VietlottKeno.ViewModels.VietlottKenoViewModel

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/lib/data-tables/datatables.min.css" />
    <link href="~/scss/pages/vietlottkeno.min.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Vietlott Keno";
}

<form class="form filter" data-ajax="true" data-ajax-method="GET" asp-action="GetVietlottKenoRounds"
      data-ajax-mode="replace"
      data-ajax-update="#keno-round-result .card-body"
      data-ajax-loading="#spinner"
      data-ajax-success="vietlottKeno.init"
      method="get"
      id="keno-form">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label asp-for="Date" class="control-label"></label>
            <input type="date" class="form-control" asp-for="Date">
        </div>
        <div class="col-auto mt-5">
            <button type="submit" class="btn-submit">Submit</button>
            <a class="btn-add"
               data-ajax="true" data-ajax-mode="replace" data-ajax-update="#modal .modal-content" data-ajax-success="vietlottKeno.onOpenAddNewRoundForm"
               asp-action="AddNewRound">
                Add
            </a>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<div id="keno-round-result" class="card">
    <div class="card-body"></div>
</div>

<div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-labelledby="modal" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts
{
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script src="~/js/vietlott-keno.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
    </environment>
}