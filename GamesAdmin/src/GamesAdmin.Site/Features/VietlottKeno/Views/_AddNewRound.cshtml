@model GamesAdmin.Site.Features.VietlottKeno.ViewModels.AddVietlottKenoRoundViewModel

<div class="modal-header">
    <h5 class="modal-title">Add new round</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<form data-ajax="true" asp-action="AddNewRound" method="post" id="add-new-round-form"
      data-ajax-failure="vietlottKeno.onAddNewRoundFailure">
    <div class="modal-body">
        <div class="form-group">
            <label asp-for="RoundNo"></label>
            <input class="form-control" type="number" asp-for="RoundNo">
            <span asp-validation-for="RoundNo"></span>
        </div>
        <div class="form-group">
            <label asp-for="Date"></label>
            <input class="form-control" type="datetime-local" asp-for="Date">
            <span asp-validation-for="Date"></span>
        </div>
        <div class="form-group">
            <label>Result</label>
            @for (var i = 0; i < Model.Result.Count(); i++)
            {
                <input class="form-control" type="number" asp-for="Result[i].Number" placeholder="1 to 80" />
            }
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Submit</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
    </div>
</form>