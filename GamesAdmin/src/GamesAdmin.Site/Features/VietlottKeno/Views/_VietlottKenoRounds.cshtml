@using GamesAdmin.Core

@model IEnumerable<GamesAdmin.Site.Features.VietlottKeno.ViewModels.ViewlottKenoRoundViewModel>

<table id="vietlott-keno-table" class="table table-bordered table-hover stripe">
    <thead>
        <tr>
            <th>Round No / Time (GMT+7)</th>
            <th>Result</th>
            <th>Big / Small</th>
            <th>Even / Odd</th>
            <th>Element</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">
                    @item.RoundNo
                    <div>@item.Time.ToString(Constants.TimeFormat)</div>
                </td>
                <td>@string.Join(" - ", item.Result)</td>
                <td class="text-center">@(item.Big ? "Big" : "Small")</td>
                <td class="text-center">@(item.Even ? "Even" : "Odd")</td>
                <td class="text-center">
                    @if (item.Gold)
                    {
                        @("Gold")
                    }
                    @if (item.Wood)
                    {
                        @("Wood")

                    }
                    @if (item.Water)
                    {
                        @("Water")

                    }
                    @if (item.Fire)
                    {
                        @("Fire")

                    }
                    @if (item.Earth)
                    {
                        @("Earth")
                    }
                </td>
            </tr>
        }
    </tbody>
</table>