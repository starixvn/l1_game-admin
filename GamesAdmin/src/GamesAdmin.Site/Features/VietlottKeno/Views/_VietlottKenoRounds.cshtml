@using GamesAdmin.Core

@model IEnumerable<GamesAdmin.Site.Features.VietlottKeno.ViewModels.ViewlottKenoRoundViewModel>

<table id="vietlott-keno-table" class="table table-bordered table-hover stripe tble-vietlot">
    <thead>
        <tr>
            <th>Round No / Time (GMT+7)</th>
            <th>Result</th>
            <th>Total</th>
            <th>Big / Small</th>
            <th>Even / Odd</th>
            <th>Element</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">
                    @item.RoundNo
                    <div>@item.Time.ToString(Constants.TimeFormat)</div>
                </td>
                <td>
                    @if (item.Result != null)
                    {
                        <div class="list-numbers">
                            @foreach (var number in item.Result)
                            {
                                <span class="number">
                                    @number
                                </span>
                            }
                        </div>
                    }
                </td>
                <td class="text-center">@item.Result?.Sum(x => x)</td>
                <td class="text-center">@(item.Big.HasValue ? item.Big.Value ? "Big" : "Small" : string.Empty)</td>
                <td class="text-center">@(item.Even.HasValue ? item.Even.Value ? "Even" : "Odd" : string.Empty)</td>
                <td class="text-center">
                    @if (item.Gold.HasValue && item.Gold.Value)
                    {
                        @("Gold")
                    }
                    @if (item.Wood.HasValue && item.Wood.Value)
                    {
                        @("Wood")

                    }
                    @if (item.Water.HasValue && item.Water.Value)
                    {
                        @("Water")

                    }
                    @if (item.Fire.HasValue && item.Fire.Value)
                    {
                        @("Fire")

                    }
                    @if (item.Earth.HasValue && item.Earth.Value)
                    {
                        @("Earth")
                    }
                </td>
            </tr>
        }
    </tbody>
</table>