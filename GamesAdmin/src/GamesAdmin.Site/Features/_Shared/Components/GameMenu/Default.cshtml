        </a>
    </li>

    <li class="menu-item">
        <a asp-action="SeDie" asp-controller="Report">
            <i class="material-icons menu-icon"></i>
            <span class="menu-name">Se Die</span>
        </a>
    </li>

    <li class="menu-item">
        <a asp-action="MiniSeDie" asp-controller="Report">
            <i class="material-icons menu-icon"></i>
            <span class="menu-name">Mini Se Die</span>
        </a>
    </li>
</ul>