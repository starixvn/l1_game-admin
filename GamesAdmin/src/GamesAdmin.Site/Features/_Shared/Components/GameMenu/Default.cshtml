@using System.Security.Claims;
@using GamesAdmin.Site.Features._Shared.Components.ViewModels;
@model MenuViewModel;

    <ul class="vertical-nav-menu">
        <li class="menu-item">
            <a asp-action="Index" asp-controller="Dashboard">
                <i class="material-icons menu-icon">store_mall_directory</i>
                <span class="menu-name">Dashboard</span>
            </a>
        </li>
        <li class="nav-heading">Setting</li>
        <li class="menu-item">
            <a asp-action="Notification" asp-controller="Setting" class="add-new-game">
                <i class="material-icons menu-icon">wb_sunny</i>
                <span class="menu-name">Notification</span>
            </a>
        </li>
        <li class="menu-item">
            <a asp-action="GameStatus" asp-controller="Setting" class="add-new-game">
                <i class="material-icons menu-icon">verified_user</i>
