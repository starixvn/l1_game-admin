                <i class="material-icons menu-icon">group</i>
                <span class="menu-name">User Management</span>
            </a>
        </li>
        <li class="menu-item">
            <a asp-action="Add" asp-controller="GameSettings" class="add-new-game">
                <i class="material-icons menu-icon">format_list_numbered</i>
                <span class="menu-name">Top 20</span>
            </a>
        </li>
        <li class="nav-heading">Information</li>
        <li class="menu-item">
            <a asp-action="Add" asp-controller="GameSettings" class="add-new-game">
                <i class="material-icons menu-icon">share</i>
                <span class="menu-name">Permission Control</span>
            </a>
        </li>
        <li class="nav-heading">Game</li>
        @foreach (var item in Model.GameList)
        {
            <li class="menu-item">
                <a asp-route-name="@item.Value" asp-action="Edit" asp-controller="GameSettings">
                    <i class="material-icons menu-icon">bubble_chart</i>
                    <span class="menu-name">@item.DisplayName</span>
                </a>
            </li>

        }
        <li class="menu-item">
            <a asp-action="RedirectToPanel" asp-controller="Home" target="_blank">
                <i class="material-icons menu-icon">assessment</i>
                <span class="menu-name">Total Bets</span>
            </a>
        </li>


        @if (Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value == "admin")
        {
            <li class="menu-item">
                <a asp-action="Add" asp-controller="GameSettings" class="add-new-game">
                    <i class="material-icons menu-icon">note_add</i>
                    <span class="menu-name">Add new game</span>
                </a>
            </li>

            <li class="menu-item">
                <a asp-action="add" asp-controller="account">
                    <i class="material-icons menu-icon">person_add</i>
                    <span class="menu-name">Generate user/bot</span>
                </a>
            </li>
            <li class="menu-item">
                <a asp-action="revisebots" asp-controller="account">
                    <i class="material-icons menu-icon">adb</i>
                    <span class="menu-name">Revise bots</span>
                </a>
            </li>

            <li class="nav-heading">Users</li>
            <li class="menu-item">
                <a asp-action="Index" asp-controller="User">
                    <i class="material-icons menu-icon">people_alt</i>
                    Management
                </a>
            </li>
            <li class="menu-item">
                <a asp-action="Add" asp-controller="User">
                    <i class="material-icons menu-icon">person_add</i>
                    <span class="menu-name">Add New User</span>
                </a>
            </li>

            <li class="menu-item">
                <a asp-action="Index" asp-controller="ClientSite">
                    <i class="material-icons menu-icon">people_alt</i>
                    <span class="menu-name">Client Sites</span>
                </a>
            </li>
        }

        <li class="nav-heading">Report</li>

        <li class="menu-item">
            <a asp-action="BigSmall" asp-controller="Report">
                <i class="material-icons menu-icon">assessment</i>
                <span class="menu-name">Big Small</span>
            </a>
        </li>

