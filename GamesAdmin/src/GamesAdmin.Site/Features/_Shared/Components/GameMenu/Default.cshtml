            <span class="menu-name">Big Small</span>
        </a>
    </li>

    <li class="menu-item">
        <a asp-action="BigSmallTurbo" asp-controller="Report">
            <i class="material-icons menu-icon"></i>
            <span class="menu-name">Big Small Turbo</span>
        </a>
    </li>

    <li class="menu-item">
