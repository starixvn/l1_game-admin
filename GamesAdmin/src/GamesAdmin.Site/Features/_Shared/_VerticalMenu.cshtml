                <i class="icon-account-group menu-icon"></i>
                <span class="menu-name">UM Info</span>
            </a>
        </li>

        <li class="nav-heading">Currencies</li>
        <li class="menu-item">
            <a asp-action="Index" asp-controller="Currency">
                <i class="icon-account-group menu-icon"></i>
