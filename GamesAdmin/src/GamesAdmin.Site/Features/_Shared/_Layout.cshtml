<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="favicon.ico">
    <link href="~/css/site.min.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", false)
</head>
<body>
    <div class="main-container">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="/" class="site-name">Saba.Club <span class="highlight">Admin</span> (CASH)</a>
                <button type="button" id="sidebarCollapse" class="btn btn-hamburger">
                    <!--<i class="material-icons">menu</i>-->
                    <span class="hamburger-inner"></span>
                </button>
            </div>
            <div class="scrollbar-sidebar">
                <div class="sidebar__inner">
                    @await Component.InvokeAsync("GameMenu", new { })
                </div>
            </div>
        </div>
        <div id="content" class="content-container">
            <div class="header">
                <div class="page-title">@ViewData["Title"]</div>
                <div class="user-info">
                    <div class="dropdown">
                        <button class="dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="material-icons icon-user">account_circle</i>
                            @Context.User.Claims.FirstOrDefault(c => c.Type == "Username")?.Value
                        </button>
                        <form asp-action="Logout" asp-controller="Authentication" method="post">
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                                @*<li>
                                        <a asp-action="Index" asp-controller="ChangePassword">
                                            <i class="material-icons">lock_open</i> Change Password
                                        </a>
                                    </li>*@
                                <li>
                                    <button type="submit" value="Sign out" class="logout">
                                        <i class="material-icons">exit_to_app</i> Logout
                                    </button>
                                </li>
                            </ul>
                        </form>
                    </div>
                </div>
            </div>

            <div class="inner-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>