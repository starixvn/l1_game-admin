<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="favicon.ico">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/scss/base/roboto.min.css" rel="stylesheet" />
    <link href="~/scss/base/material-icon.min.css" rel="stylesheet" />
    <link href="~/scss/pages/site.min.css" rel="stylesheet" />
    @RenderSection("Styles", false)
</head>
<body>
    <div class="main-container">
        <div class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <a href="/" class="site-name">Saba.Club <span class="highlight">Admin</span></a>
                <button type="button" id="sidebarCollapse" class="btn btn-hamburger">
                    <!--<i class="material-icons">menu</i>-->
                    <span class="hamburger-inner"></span>
                </button>
            </div>
            <div class="scrollbar-sidebar">
                <div class="sidebar__inner">                    
                        @await Component.InvokeAsync("GameMenu", new { })                    
                </div>
            </div>
        </div>
        <div id="content" class="content-container">
            <div class="header">
                <div class="page-title">@ViewData["Title"]</div>
                <div class="user-info">
                    <div class="dropdown">
                        <button class="dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="material-icons icon-user">account_circle</i>
                            @Context.User.Claims.FirstOrDefault(c => c.Type == "Username")?.Value
                        </button>
                        <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                            <form asp-action="Logout" asp-controller="Authentication" method="post">
                                <button type="submit" value="Sign out" class="logout">Logout</button>
                            </form>                            
                        </div>
                    </div>
                </div>
            </div>          

            <div class="inner-content">
                @RenderBody()
            </div>
        </div>
    </div>    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
