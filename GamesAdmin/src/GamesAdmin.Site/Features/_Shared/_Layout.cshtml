<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/scss/fonts/Awsome/css/font-awesome.css" rel="stylesheet" />
    <link href="~/scss/page.css" rel="stylesheet" />
</head>
<body>
    <div class="main-container">
        <div class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="site-name">Saba.Club <span class="highlight">Admin</span></a>
                <button type="button" id="sidebarCollapse" class="btn btn-hamburger">
                    <i class="fa fa-bars"></i>
                </button>
            </div>
            <div class="scrollbar-sidebar">
                <div class="sidebar__inner">                    
                        @await Component.InvokeAsync("GameMenu", new { })                    
                </div>
            </div>
        </div>
        <div id="content" class="content-container">
            <div class="header-bar">
                <ul class="nav">
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Dashboard" class="nav-link">
                            <span>Dashboard</span>
                        </a>                        
                    </li>
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Forecast" class="nav-link">
                            <span>Forecast</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a role="tab" data-toggle="tab" class="nav-link active" href="#setting" >
                            <span>Setting</span>
                        </a>
                    </li>
                </ul>
            </div>

            @RenderBody()
        </div>
    </div>    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
