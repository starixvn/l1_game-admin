@using System.Text;
@using GamesAdmin.Site.Features.ResultMonitor.ViewModels
@model CascadingSlotBoardViewModel
@{
    var imageFolder = Model.Name.ToLowerInvariant();
}

@functions {
    public string RenderBoard(IEnumerable<byte> board, string imageFolder)
    {
        var sb = new StringBuilder();
        var iconPerRow = 6;
        var col = iconPerRow;

        foreach (var b in board)
        {
            if (col == 1)
            {
                sb.AppendLine("<br />");
                col = iconPerRow;
            }

            sb.AppendLine("<img class='small-symbol' src='/images/slot-icons/" + imageFolder + "/" + b + ".png' />");
            col--;
        }

        return sb.ToString();
    }
}


@if (Model.IsError)
{
    <div class="message-error" id="failedMsg">
        Sending result unsuccessfully. The following conditions that must be satisfied in order to monitor board result.<br />
        - Result cannot be set for real user and banned bot. <br />
        - Result cannot be set for UUS user when the "Exclude UUS" setting is TRUE. <br />
    </div>
}
else
{
    <table class="table table-bordered table-cascading-slot">
        <thead>
            <tr>
                <th>Type</th>
                <th>Winning Symbol</th>
                <th>Number of Synmbol</th>
                <th>Multiplier</th>
                <th>Scatter</th>
                <th>Result Board</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var board in Model.SettlementResult.Boards)
            {
                if (board.WinningSymbols == null || board.WinningSymbols.Count == 0)
                {
                    <tr>
                        <td class="text-center">@board.Name</td>
                        <td class="text-center">-</td>
                        <td class="text-center">-</td>
                        <td class="text-center">@board.Multiplier</td>
                        <td class="text-center">@board.Scatter</td>
                        <td class="text-center">@Html.Raw(RenderBoard(board.Result, imageFolder))</td>
                    </tr>
                }
                else
                {
                    var firstRow = true;
                    foreach (var winning in board.WinningSymbols)
                    {
                        if (firstRow)
                        {
                            <tr>
                                <td rowspan="@board.WinningSymbols.Count" class="text-center">@board.Name</td>
                                <td class="text-center"><img class="symbol" src="~/images/slot-icons/@imageFolder/@(winning.Key).png" /></td>
                                <td class="text-center">@winning.Value</td>
                                <td rowspan="@board.WinningSymbols.Count" class="text-center">@board.Multiplier</td>
                                <td rowspan="@board.WinningSymbols.Count" class="text-center">@board.Scatter</td>
                                <td rowspan="@board.WinningSymbols.Count" class="text-center">@Html.Raw(RenderBoard(board.Result, imageFolder))</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td class="text-center"><img class="symbol" src="~/images/slot-icons/@imageFolder/@(winning.Key).png" /></td>
                                <td class="text-center">@winning.Value</td>
                            </tr>
                        }

                        firstRow = false;
                    }
                }
            }
        </tbody>
    </table>
}

