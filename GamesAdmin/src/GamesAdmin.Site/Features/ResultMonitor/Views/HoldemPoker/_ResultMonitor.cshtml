@using GamesAdmin.Core.Models.RoundResults;
@using GamesAdmin.Core;
@using GamesAdmin.Core.Models;
@using GamesAdmin.Core.Models.BetReport;
@model HoldemPokerResultControl

<div>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th></th>
                <th>Cards</th>
                <th>Combination</th>
                <th>Result</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Player</td>
                <td> @{await RenderCards(Model.playerResult.Cards);}</td>
                <td> @{await RenderCards(Model.playerResult.CombinationCards);}</td>
                <td>@Model.playerResult.Rank</td>
            </tr>
            <tr>
                <td>Dealer</td>
                <td> @{await RenderCards(Model.dealerResult.Cards);}</td>
                <td> @{await RenderCards(Model.dealerResult.CombinationCards);}</td>
                <td>@(Model.isQualified ? Model.dealerResult.Rank : "Does Not Qualify")</td>
            </tr>
            <tr>
                <td>Community Cards</td>
                <td> @{await RenderCards(Model.communityCards);}</td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>
</div>

@functions
{

    private async Task RenderCards(IEnumerable<PokerCard> cards)
    {
        <div class="cards">
            @foreach (var card in cards)
            {
                <div class="card card-type-@card.suit">
                    <span>@CardLabels.DisplayedName[card.rank]</span>
                    <img class="img" src="~/images/card_@(card.suit).png" />
                </div>
            }
        </div>
    }
}
