@using GamesAdmin.Site.Features.ResultMonitor.ViewModels
@model SettlementBoardViewModel

@if (Model.IsError)
{
<div class="message-error" id="failedMsg">    
    Cannot send result to game service. There are some causes:<br />
    - Cannot set result for real user and banned bot. <br />
    - Setting result for UUS user but "Exclude UUS" is TRUE. <br />
    Please double check.
</div>
}
else
{
    <table class="table table-bordered table-four-guardians">
        <thead>
            <tr>
                <th>Winning Paylines</th>
                <th>Free Spins</th>
                <th>Bonus</th>
                <th>Jackpot</th>
                <th>Board</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    @Model.WinningPaylines
                </td>
                <td>
                    @Model.NumberOfFreeSpins
                </td>
                <td>
                    @Model.NumberOfBonus
                </td>
                <td>
                    @Model.Jackpot
                </td>
                <td>
                    <table class="table-paylines">
                        <tbody>
                            @{
                                for (var row = 0; row < Model.FormattedBoard.Length; row++)
                                {
                                    <tr>
                                        @for (var column = 0; column < Model.FormattedBoard[row].Length; column++)
                                        {
                                            <td><img class="symbol" src="~/images/slot-icons/fourguardians/@(Model.FormattedBoard[row][column]).png" /></td>
                                        }
                                    </tr>

                                }
                            }
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>
}

