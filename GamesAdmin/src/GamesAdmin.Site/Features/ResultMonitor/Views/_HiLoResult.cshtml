@using GamesAdmin.Site.Features.Report.ViewModels;
@model IEnumerable<CardViewModel>

<h3>Card Result</h3>
<table class="table table-bordered">

    <tbody>
        <tr>
            <td>Total Cards</td>
            <td>
                @Model.Count()
            </td>
        </tr>
        <tr>
            <td>No. of Turn</td>
            <td>
                @(Model.Count() - 1)
            </td>
        </tr>
        <tr>
            <td>Card Details</td>
            <td>
                <div class="cards">
                    @foreach (var card in Model)
                    {
                        <div class="card card-type-@card.Suit">
                            <span>@card.Rank</span>
                            <img class="img" src="~/images/card_@(card.Suit).png" />
                        </div>
                    }
                </div>
            </td>
        </tr>
    </tbody>
</table>