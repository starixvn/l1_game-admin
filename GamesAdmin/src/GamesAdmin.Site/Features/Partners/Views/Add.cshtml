@using GamesAdmin.Site.Features.Partners.ViewModels;
@model AddViewModel;

@{
    ViewData["Title"] = "Partner";
}


<div class="col-md-12 col-lg-6 card">
    @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
    {
        <div class="message-error"><i class="icon-cancel"></i> @Model.ErrorMessage</div>
    }
<form class="card-body form-add form" asp-action="Add" asp-controller="Partner" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="PartnerId" class="control-label"></label>
        <input type="text" asp-for="PartnerId" class="form-control" />
        <span asp-validation-for="PartnerId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input type="text" asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="SecretKey" class="control-label"></label>
        <input type="text" asp-for="SecretKey" class="form-control" />
        <span asp-validation-for="SecretKey" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CasinoVersionUrl" class="control-label"></label>
        <input type="text" asp-for="CasinoVersionUrl" class="form-control" />
        <span asp-validation-for="CasinoVersionUrl" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MiniVersionUrl" class="control-label"></label>
        <input type="text" asp-for="MiniVersionUrl" class="form-control" />
        <span asp-validation-for="MiniVersionUrl" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MobiVersionUrl" class="control-label"></label>
        <input type="text" asp-for="MobiVersionUrl" class="form-control" />
        <span asp-validation-for="MobiVersionUrl" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ApiUrl" class="control-label"></label>
        <input type="text" asp-for="ApiUrl" class="form-control" />
        <span asp-validation-for="ApiUrl" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Add" class="btn-submit" />
    </div>
</form>
</div>

