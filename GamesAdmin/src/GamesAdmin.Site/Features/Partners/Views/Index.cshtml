@using GamesAdmin.Site.Features.Partners.ViewModels;
@using System.Security.Claims;

@model IndexViewModel;

@{ ViewData["Title"] = "Partners"; }

@section Styles {
    <link href="~/css/partner.min.css" rel="stylesheet" asp-append-version="true" />
}

<div class="col-md-12 col-lg-12 p-0">
    @if (Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value == "admin")
    {
        <div class="row align-items-center p-2">
            <div class="col-auto list-buttons ">
                <button class="btn-add" onclick="partner.showAddForm()">
                    Add Partner
                </button>
            </div>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <table id="partner-table" class="table table-bordered has-background">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Secret Key</th>
                        <th>Saba.club URL</th>
                        <th>Instant URL</th>
                        <th>Saba.mobi URL</th>
                        <th>API URL</th>
                        <th>Test Currency URL</th>
                        @if (Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value == "admin")
                        {
                            <th></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Partners)
                    {
                        <tr>
                            <td>@item.PartnerId</td>
                            <td>@item.Name</td>
                            <td>@item.SecretKey</td>
                            <td>@item.ClubVersionUrl</td>
                            <td>@item.MiniVersionUrl</td>
                            <td>@item.MobiVersionUrl</td>
                            <td>@item.ApiUrl</td>
                            <td>@item.TestCurrencyUrl</td>
                            @if (Context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value == "admin")
                            {
                                <td class="text-center">
                                    <button class="btn-edit" onclick="partner.showEditForm('@item.PartnerId')"><i class="icon-edit"></i></button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="modal fade game-modal" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Edit Partner
                </div>
                <div class="modal-body" id="editModalContent">
                    ...
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade game-modal" id="addModal" tabindex="-1" role="dialog" aria-labelledby="addModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    Add Partner
                </div>
                <div class="modal-body" id="addModalContent">
                    ...
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <environment include="Development">
        <script src="~/lib/data-tables/datatables.js"></script>
        <script src="~/js/partner.js" asp-append-version="true"></script>
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/partner.min.js" asp-append-version="true"></script>
    </environment>

}