@using GamesAdmin.Site.Features.BuyFreeSpins.ViewModels
@using GamesAdmin.Site.Features._Shared;
@model IEnumerable<BuyFreeSpinSettingViewModel>

@section Styles {
    <link href="~/css/buy-free-spin-setting.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/data-tables/datatables.min.css" rel="stylesheet" />
}

@{
    ViewData["Title"] = "Buy Free Spin Setting";

    var hasEditPermission = Context.HasAdminPermission();
}


@if (hasEditPermission)
{
    <div class="list-actions">
        <form id="bf-search-form" class="form form-inline">

            <input type="button" onclick="buyFreeSpinSetting.showEnableDisable(true)" value="ENABLE"
                   class="btn-add btn-enable" />
            <input type="button" onclick="buyFreeSpinSetting.showEnableDisable(false)" value="DISABLE"
                   class="btn-gray btn-enable" />

            <a class="btn-add right" data-ajax="true" data-ajax-mode="replace" data-ajax-update="#modal .modal-content"
               data-ajax-success="buyFreeSpinSetting.openAddBuyFreeSpinSettingForm" asp-action="Create">
                Add Buy Free Spin Setting
            </a>

        </form>
    </div>
}

<p class="control-label" id="result-label"></p>

<div id="buy-free-spins-setting-management">
    <div class="card-body">
        <table id="buy-free-spins-setting-table" class="table table-bordered table-hover stripe sticky-table">
            <thead>
                <tr>
                    @if (hasEditPermission)
                    {
                        <th class="text-center">
                            <input type="checkbox" id="select-all-buy-free-spins" />
                        </th>
                    }
                    <th>Game</th>
                    <th>Multiplier</th>
                    <th>Enabled</th>
                    @if (hasEditPermission)
                    {
                        <th>Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (hasEditPermission)
                        {
                            <td class="text-center">
                                <input type="checkbox" class="buy-free-spin-checkbox" data-game-id="@item.GameId" />
                            </td>
                        }
                        <td class="text-center">@item.GameName</td>
                        <td class="text-center">@(item.Multiplier)x</td>
                        <td class="text-center">
                            <i class='@(item.Enabled ? "icon-check" : "icon-cancel")'></i>
                        </td>
                        @if (hasEditPermission)
                        {
                            <td class="text-center">
                                <a class="btn-edit" data-ajax="true" data-ajax-mode="replace"
                                   data-ajax-update="#modal .modal-content"
                                   data-ajax-success="buyFreeSpinSetting.openUpdateBuyFreeSpinSettingForm"
                                   asp-route-gameId="@item.GameId" asp-action="Update">
                                    <i class="icon-edit"></i>
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modal" tabindex="-1" aria-labelledby="modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
<div class="modal fade enable-disable-modal" id="enableDisableModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation<span id="enableDisableTitle"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body reload-content-body">
                <div class="message-success hidden-cls" id="updateMsgSuccess">
                    <i class="icon-check"></i><span>
                        Updated
                        successfully
                    </span>
                </div>
                <div class="message-error hidden-cls" id="updateMsgFailed">
                    <i class="icon-cancel"></i><span>Error</span>
                </div>
                <div id="enableDisableContent" class="content-body"></div>

                <input type="hidden" id="enableDisableFlag" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-gray" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-submit" id="confirmBtn"
                        onclick="buyFreeSpinSetting.submitEnableDisable()">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade game-modal" id="alertModal" tabindex="-1" aria-labelledby="exampleModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Alert</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body reload-content-body" id="alertContent">
                You should choose at least one game
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-submit" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script src="~/js/buy-free-spin-setting.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/buy-free-spin-setting.min.js" asp-append-version="true"></script>
    </environment>
}