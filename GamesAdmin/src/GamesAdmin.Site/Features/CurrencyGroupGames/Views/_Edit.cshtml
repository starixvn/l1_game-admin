        <li class="nav-item">
            <a class="nav-link active" id="general-tab-header" href="#" onclick="gameStatus.toggleSettingTabs('settings')">Setting</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="payouts-tab-header" href="#" onclick="gameStatus.toggleSettingTabs('siteExcludsion')">Site excludsion</a>
        </li>
    </ul>

    <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Updated successfully</span></div>
    <div class="message-error hidden-cls" id="failedMsg"><i class="icon-cancel"></i><span>Error</span></div>

