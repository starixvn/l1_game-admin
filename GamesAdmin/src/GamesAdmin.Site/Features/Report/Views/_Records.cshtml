@using GamesAdmin.Site.Features.Report.ViewModels;
@model IEnumerable<BigSmallRecordViewModel>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Username</th>
            <th>Nickname</th>
            <th>Stake</th>
            <th>Refund</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Username</td>
                <td>@item.Nickname</td>
                <td class="text-right">@item.Bet</td>
                <td class="text-right">@item.Back</td>
                <td class="text-right">@item.BetWin</td>
            </tr>

        }
    </tbody>
    <tfoot>
        @*<tr>
            <td class="text-center" colspan="5">No data</td>
        </tr>*@
        <tr class="total">
            <td>Total</td>
            <td></td>
            <td class="text-right">@Model.Sum(x => x.Bet)</td>
            <td class="text-right">@Model.Sum(x => x.Back)</td>
            <td class="text-right">@Model.Sum(x => x.BetWin)</td>
        </tr>
    </tfoot>
</table>