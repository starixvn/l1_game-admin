@using GamesAdmin.Site.Features.Report.ViewModels;
@model IEnumerable<BigSmallRecordViewModel>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Username</th>
            <th>Nickname</th>
            <th>Stake</th>
            <th>Refund</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Username</td>
                <td>@item.Nickname</td>
                <td>@item.Bet</td>
                <td>@item.Back</td>
                <td>@item.BetWin</td>
            </tr>

        }
        <tr>
            <td>Total</td>
            <td></td>
            <td>@Model.Sum(x => x.Bet)</td>
            <td>@Model.Sum(x => x.Back)</td>
            <td>@Model.Sum(x => x.BetWin)</td>
        </tr>
    </tbody>
</table>