@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@{
    var betChoiceDictionary = new Dictionary<string, string>
{
        { "odd", "Odd" },
        { "even", "Even" },
        { "white3", "1 Red" },
        { "red2", "2 Red" },
        { "red3", "3 Red" },
        { "red4", "4 Red" },
        { "white4", "4 White" },
    };
}

@model IEnumerable<VipSeDieBetHistoryRecordViewModel>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Date (GMT+7)</th>
            <th>Bet Choice</th>
            <th>Bet Amount</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var bet in Model)
        {
            <tr>
                <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                <td>@betChoiceDictionary[bet.Choice]</td>
                <td>
                    @HtmlHelpers.formatNumber(bet.Amount)
                </td>
            </tr>
        }
    </tbody>
</table>