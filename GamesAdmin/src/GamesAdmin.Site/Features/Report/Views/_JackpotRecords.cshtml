@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model JackpotReportResultViewModel

<div class="row row-table">
    <div class="col-sm-12">
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-nickname">Operator</th>
                    <th class="col-nickname">Site Name</th>
                    <th class="col-nickname">Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Round</th>
                    <th class="col-exchange-id">Exchange Id</th>
                    <th class="col-number">Prize</th>
                    <th class="col-number">Jackpot Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Records)
                {

                    <tr>
                        <td>@item.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@item.OperatorName</td>
                        <td class="text-center">@item.SiteName</td>
                        <td class="text-center">@item.Username</td>
                        <td class="text-center">@item.Nickname</td>
                        <td class="text-center">@item.Currency</td>

                        <td class="text-center">
                            @item.RoundId
                        </td>
                        <td class="text-center">@item.ExchangeRateId</td>
                        <td class="text-center">@item.DisplayPrize</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(item.WinningAmount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td class="text-center" colspan="10">No data</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>