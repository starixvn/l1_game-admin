@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model IEnumerable<JackpotRecordViewModel>

<div class="row row-table">
    <div class="col-sm-12">
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-nickname">Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-number">Round</th>
                    <th class="col-number">Stake Level</th>
                    <th class="col-number">Jackpot Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {

                    <tr>
                        <td>@item.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@item.Username</td>
                        <td>@item.Nickname</td>
                        <td class="text-center">
                            @item.RoundId
                        </td>
                        <td class="text-right">@HtmlHelpers.formatNumber(item.Pool)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(item.WinningAmount)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (!Model.Any())
                {
                    <tr>
                        <td class="text-center" colspan="10">No data</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>