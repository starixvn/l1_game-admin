@using GamesAdmin.Site.Features.Report.ViewModels;
@model IEnumerable<BigSmallRecordViewModel>

@{
    var bigRecords = Model.Where(x => x.SelectBig);
    var smallRecords = Model.Where(x => !x.SelectBig);
}

<ul class="nav nav-tabs" id="tab" role="tablist">
    <li class="nav-item">
        <a class="nav-link active" id="big-result-tab" data-toggle="tab" href="#big-result" role="tab" aria-controls="small-result" aria-selected="true">Big</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" id="small-result-tab" data-toggle="tab" href="#small-result" role="tab" aria-controls="small-result" aria-selected="false">Small</a>
    </li>
</ul>
<div class="tab-content">
    <div class="tab-pane fade show active" id="big-result" role="tabpanel" aria-labelledby="big-result-tab">
        @await Html.PartialAsync("_Records", bigRecords)
    </div>
    <div class="tab-pane fade" id="small-result" role="tabpanel" aria-labelledby="small-result-tab">
        @await Html.PartialAsync("_Records", smallRecords)
    </div>
</div>