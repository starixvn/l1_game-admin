@using GamesAdmin.Site.Features.Report.ViewModels;
@model IEnumerable<BigSmallRecordViewModel>

@{
    var bigRecords = Model.Where(x => x.SelectBig);
    var smallRecords = Model.Where(x => !x.SelectBig);
}

<div class="tab-content">
    <div>
        <div>Big</div>
        @await Html.PartialAsync("_Records", bigRecords)
    </div>
    <div>
        <div>Small</div>
        @await Html.PartialAsync("_Records", smallRecords)
    </div>
</div>