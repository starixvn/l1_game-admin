@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model BigSmallReportResultViewModel

@{
    var bigRecords = Model.Records.Where(x => x.Select).ToList();
    var smallRecords = Model.Records.Where(x => !x.Select).ToList();
    var totalRow = bigRecords.Count > smallRecords.Count ? bigRecords.Count : smallRecords.Count;
    var round = Model.RoundResult;
}

<div class="row">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Results</th>
                        <th>Total</th>
                        <th>Winning Options</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">
                            <div class="dice-list">
                                <img class="dice" src="~/images/dice_@(Model.RoundResult.Dice1).png" />
                                <img class="dice" src="~/images/dice_@(Model.RoundResult.Dice2).png" />
                                <img class="dice" src="~/images/dice_@(Model.RoundResult.Dice3).png" />
                            </div>
                        </td>
                        <td class="text-center">@Model.RoundResult.Total</td>
                        <td class="text-center">@(Model.RoundResult.IsBig ? "Big": "Small")</td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th colspan="8" class="big-small-title">Big</th>
                    <th class="line-cell"></th>
                    <th colspan="8" class="big-small-title">Small</th>
                </tr>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Partner</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                    <th class="line-cell"></th>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Partner</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < totalRow; i++)
                {
                    var bigRecord = bigRecords.ElementAtOrDefault(i);
                    var smallRecord = smallRecords.ElementAtOrDefault(i);
                    <tr>
                        <td>@bigRecord?.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@bigRecord?.Partner</td>
                        <td>@bigRecord?.Username</td>
                        <td>
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetBigSmallBetHistory" asp-route-roundId="@Model.RoundResult.Number" asp-route-nickname="@bigRecord?.Nickname">
                                @bigRecord?.Nickname
                            </a>
                        </td>
                        <td>@bigRecord?.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(bigRecord?.BaseBetAmount))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(bigRecord?.BaseBack))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(bigRecord?.BaseBetWin))</td>
                        <td class="line-cell"></td>
                        <td>@smallRecord?.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@smallRecord?.Partner</td>
                        <td>@smallRecord?.Username</td>
                        <td>@smallRecord?.Currency</td>
                        <td class="col-nickname">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetBigSmallBetHistory" asp-route-roundId="@Model.RoundResult.Number" asp-route-nickname="@smallRecord?.Nickname">
                                @smallRecord?.Nickname
                            </a>
                        </td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(smallRecord?.BaseBetAmount))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(smallRecord?.BaseBack))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(smallRecord?.BaseBetWin))</td>
                    </tr>

                }
            </tbody>
            <tfoot>
                @if (totalRow == 0)
                {
                    <tr>
                        <td class="text-center" colspan="13">No data</td>
                    </tr>
                }
                else
                {
                    <tr class="total">
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(bigRecords.Sum(x => x.BaseBetAmount)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(bigRecords.Sum(x => x.BaseBack)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(bigRecords.Sum(x => x.BaseBetWin)))</td>
                        <td class="line-cell"></td>
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(smallRecords.Sum(x => x.BaseBetAmount)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(smallRecords.Sum(x => x.BaseBack)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(smallRecords.Sum(x => x.BaseBetWin)))</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>