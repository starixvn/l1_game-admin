@using GamesAdmin.Core.Models.BetReport;
@using GamesAdmin.Core;
@model CasinoHoldemPokerBetHistory
@{
    string noData = "No Data Available";
    string unfinishedGame = "Unfinished Game";
}
<div>
    <div>
        <strong>Round Id: @Model.RoundId</strong>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th></th>
                    <th>Cards</th>
                    <th>Combination</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Ante > 0)
                {
                    <tr>
                        <td>Player</td>
                        <td>
                            <div class="cards">
                                @foreach (var card in Model.Player.Cards)
                                {
                                    <div class="card card-type-@card.suit">
                                        <span>@Card.CardLabels[card.rank]</span>
                                        <img class="img" src="~/images/card_@(card.suit).png" />
                                    </div>
                                }
                            </div>
                        </td>
                        <td>
                            @if (Model.IsFold)
                            {
                                <div class="text-center">-</div>
                            }
                            else
                            {
                                <div class="cards">
                                    @foreach (var card in Model.Player.CombinationCards)
                                    {
                                        <div class="card card-type-@card.suit">
                                            <span>@Card.CardLabels[card.rank]</span>
                                            <img class="img" src="~/images/card_@(card.suit).png" />
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td>@(Model.IsFold ? "Fold" : Model.Player.Rank)</td>
                    </tr>
                    <tr>
                        <td>Dealer</td>
                        <td>
                            <div class="cards">
                                @if (Model.Ended && !Model.IsFold)
                                {
                                    @foreach (var card in Model.Dealer.Cards)
                                    {
                                        <div class="card card-type-@card.suit">
                                            <span>@Card.CardLabels[card.rank]</span>
                                            <img class="img" src="~/images/card_@(card.suit).png" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <img class="card" src="~/images/card_back.png" />
                                    <img class="card" src="~/images/card_back.png" />
                                }
                            </div>
                        </td>
                        <td>
                            <div class="cards">
                                @if (Model.Ended && !Model.IsFold)
                                {
                                    @foreach (var card in Model.Dealer.CombinationCards)
                                    {
                                        <div class="card card-type-@card.suit">
                                            <span>@Card.CardLabels[card.rank]</span>
                                            <img class="img" src="~/images/card_@(card.suit).png" />
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-center">-</div>
                                }
                            </div>
                        </td>
                        @if (Model.Ended && !Model.IsFold)
                        {
                            <td>@(Model.IsQualified ? Model.Dealer.Rank : "Does Not Qualify")</td>
                        }
                        else
                        {

                            <td>-</td>
                        }
                    </tr>
                    <tr>
                        <td>Community Cards</td>
                        <td>
                            <div class="cards">
                                @foreach (var card in Model.CommunityCards)
                                {
                                    <div class="card card-type-@card.suit">
                                        <span>@Card.CardLabels[card.rank]</span>
                                        <img class="img" src="~/images/card_@(card.suit).png" />
                                    </div>
                                }
                            </div>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            @noData
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Time (GMT + 7)</th>
                    <th>Bet Choice</th>
                    <th>Odds</th>
                    <th>Stake</th>
                    <th>Win</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Ante > 0)
                {
                    var winAnte = (Model.SettlementResult?.Ante ?? 0);
                    var winAA = (Model.SettlementResult?.AA ?? 0);
                    var winCall = (Model.SettlementResult?.Call ?? 0);
                    <tr class="@(winAnte > 0 ? "text-blue bold" : string.Empty)">
                        <td class="text-center">@Model.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">ANTE</td>
                        <td class="text-center">@Model.AnteOdds</td>
                        <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.ConvertToBase(Model.Ante) : Model.Ante)</td>
                        @if (Model.Ended)
                        {
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.ConvertToBase(winAnte) : winAnte)
                            </td>
                        }
                        else
                        {
                            <td class="text-center">@unfinishedGame</td>
                        }
                    </tr>
                    <tr class="@(winAA > 0 ? "text-blue bold" : string.Empty)">
                        <td class="text-center">@Model.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">AA</td>
                        <td class="text-center">@Model.AaOdds</td>
                        <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.ConvertToBase(Model.AA) : Model.AA)</td>
                        @if (Model.Ended)
                        {
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.ConvertToBase(winAA) : winAA)
                            </td>
                        }
                        else
                        {
                            <td class="text-center">@unfinishedGame</td>
                        }
                    </tr>
                    @if (Model.Ended && !Model.IsFold)
                    {
                        <tr class="@(winCall > 0 ? "text-blue bold" : string.Empty)">
                            <td class="text-center">@Model.CallTime.ToString(Constants.DateTimeFormat)</td>
                            <td class="text-center">CALL</td>
                            <td class="text-center">@Model.CallOdds</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.ConvertToBase(Model.Call) : Model.Call)</td>
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.ConvertToBase(winCall) : winCall)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            @noData
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

