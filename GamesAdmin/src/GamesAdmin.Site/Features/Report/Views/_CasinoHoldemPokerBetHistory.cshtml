@using GamesAdmin.Site.Features.Report.ViewModels;
@using GamesAdmin.Core;
@using GamesAdmin.Core.Models.BetReport;

@model CasinoHoldemPokerBetHistoryViewModel

@{
    string noData = "No Data Available";
    string unfinishedGame = "Unfinished Game";
    var record = Model.Record;
}
<div>
    @await Html.PartialAsync("_HoldemPokerBetHistoryCards", record)

    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Time (GMT + 7)</th>
                    <th>Bet Choice</th>
                    <th>Odds</th>
                    <th>Stake</th>
                    <th>Win</th>
                </tr>
            </thead>
            <tbody>
                @if (record.Ante > 0)
                {
                    var winAnte = (record.SettlementResult?.Ante ?? 0);
                    var winAA = (record.SettlementResult?.Aa ?? 0);
                    var winCall = (record.SettlementResult?.Call ?? 0);
                    <tr class="@(winAnte > 0 ? "text-blue bold" : string.Empty)">
                        <td class="text-center">@TimeZoneInfo.ConvertTimeFromUtc(record.Time, Model.TimeZone)</td>
                        <td class="text-center">ANTE</td>
                        <td class="text-center">@record.AnteOdds</td>
                        <td class="text-center">@FormatCurrency(record, record.Ante)</td>
                        <td class="text-center">@(record.Ended ? FormatCurrency(record, winAnte) : unfinishedGame)</td>
                    </tr>
                    @if (record.AA > 0)
                    {
                        <tr class="@(winAA > 0 ? "text-blue bold" : string.Empty)">
                            <td class="text-center">@TimeZoneInfo.ConvertTimeFromUtc(record.Time, Model.TimeZone)</td>
                            <td class="text-center">AA</td>
                            <td class="text-center">@record.AaOdds</td>
                            <td class="text-center">@FormatCurrency(record, record.AA)</td>
                            <td class="text-center">@(record.Ended ? FormatCurrency(record, winAA) : unfinishedGame)</td>
                        </tr>
                    }
                    @if (record.Ended && !record.IsFold)
                    {
                        <tr class="@(winCall > 0 ? "text-blue bold" : string.Empty)">
                            <td class="text-center">@TimeZoneInfo.ConvertTimeFromUtc(record.CallTime, Model.TimeZone)</td>
                            <td class="text-center">CALL</td>
                            <td class="text-center">@record.CallOdds</td>
                            <td class="text-center">@FormatCurrency(record, record.Call)</td>
                            <td class="text-center">@FormatCurrency(record, winCall)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            @noData
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions
{
    public string FormatCurrency(CasinoHoldemPokerBetHistory record, decimal value)
    {
        return @HtmlHelpers.formatNumber(record.ConvertToUSD ? record.ConvertToBase(value) : value);
    }
}