@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model TexasHoldemPokerReportResultViewModel

<div class="row">
    <div class="col-sm-12">
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-nickname">Date (GMT+7)</th>
                    <th>Partner</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-number">Currency</th>
                    <th class="col-number">Round Id</th>
                    <th class="col-nickname">Player</th>
                    <th class="col-nickname">Dealer</th>
                    <th class="col-number">Total Stake</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td class="text-center">@record.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@record.Partner</td>
                        <td class="text-center">@record.Username</td>
                        <td class="text-center">@record.Nickname</td>
                        <td class="text-center">@record.Currency</td>
                        <td class="text-center">@record.RoundId</td>
                        <td class="text-center">@record.PlayerResult</td>
                        <td class="text-center">@record.DealerResult</td>
                        <td class="text-center bold">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="TexasHoldemPokerBetHistory" asp-route-roundId="@record.RoundId" asp-route-nickname="@record.Nickname">
                                @record.Stake
                            </a>
                        </td>
                        <td class="text-center">@(record.Ended ? record.BetWin.ToString() : "Unfinished Game")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
