@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model CrashGameReportResultViewModel

<div class="row row-table">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Result (Crash Point)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">@Model.RoundResult.Result</td>                    
                    </tr>
                </tbody>
            </table>

        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th rowspan="2" class="col-date">Date (GMT+7)</th>
                    <th rowspan="2">Operator</th>
                    <th rowspan="2">Username</th>
                    <th rowspan="2" class="col-nickname">Nickname</th>
                    <th rowspan="2">Currency</th>   
                    <th colspan="3" class="col-number">Cashout</th>
                    <th colspan="3" class="col-number">Cashout 50%</th>
                    <th rowspan="2" class="col-number">Total Bet</th>
                    <th rowspan="2" class="col-number">Win</th>
                </tr>

                <tr>
                    <th>Multiplier</th>
                    <th>Bet</th>
                    <th>Win</th>
                    <th>Multiplier</th>
                    <th>Bet</th>
                    <th>Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {
                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@bet.Partner</td>
                        <td>@bet.Username</td>
                        <td class="text-center">
                            @bet.Nickname
                        </td>
                        <td class="text-center">@bet.Currency</td>
                        @if(bet.CashOutBetLog != null)
                        {
                            <td class="text-center">@HtmlHelpers.formatNumber(bet.CashOutBetLog.Multiplier)</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.CashOutBetLog.Amount) / Model.BaseCurrencyMultiplier : bet.CashOutBetLog.Amount)</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.CashOutBetLog.WinAmount) / Model.BaseCurrencyMultiplier : bet.CashOutBetLog.WinAmount)</td>
                        }
                        else
                        {
                            <td class="text-center">-</td>
                            <td class="text-center">-</td>
                            <td class="text-center">-</td>
                        }
                        @if (bet.HalfCashOutBetLog != null)
                        {
                            <td class="text-center">@HtmlHelpers.formatNumber(bet.HalfCashOutBetLog.Multiplier)</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.HalfCashOutBetLog.Amount) / Model.BaseCurrencyMultiplier : bet.HalfCashOutBetLog.Amount)</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.HalfCashOutBetLog.WinAmount) / Model.BaseCurrencyMultiplier : bet.HalfCashOutBetLog.WinAmount)</td>
                        }
                        else
                        {
                            <td class="text-center">-</td>
                            <td class="text-center">-</td>
                            <td class="text-center">-</td>
                        }
                       
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Amount) / Model.BaseCurrencyMultiplier : bet.Amount)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.BetWin) / Model.BaseCurrencyMultiplier : bet.BetWin)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td class="text-center" colspan="9">No data</td>
                    </tr>
                }
                else if (Model.ConvertToUSD)
                {
                   
                }
            </tfoot>
        </table>
    </div>
</div>