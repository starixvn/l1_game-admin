@if (bet.OddEven.Any() && firstBetType != bet.OddEven)
{
    foreach (var betChoice in bet.OddEven)
    {
        var winningCssClass = settlementResult.OddEven.Any(x => x == betChoice.Key) ? "text-primary" : string.Empty;
        <tr>
            <td>Odd/Even</td>
            <td class="@winningCssClass text-center text-capitalize">
                @oddEvenResource[betChoice.Key]
            </td>
            <td class="text-right @winningCssClass">
                @HtmlHelpers.formatNumber(betChoice.Value)
            </td>
        </tr>
    }
}

@if (bet.BigSmall.Any() && firstBetType != bet.BigSmall)
{
    foreach (var betChoice in bet.BigSmall)
    {
        var winningCssClass = settlementResult.BigSmall.Any(x => x == betChoice.Key) ? "text-primary" : string.Empty;
        <tr>
            <td>Big/Small</td>
            <td class="@winningCssClass text-center">
                @bigSmall[betChoice.Key]
            </td>
            <td class="text-right @winningCssClass">
                @HtmlHelpers.formatNumber(betChoice.Value)
            </td>
        </tr>
    }
}