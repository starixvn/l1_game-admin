@using GamesAdmin.Site.Features.Report.ViewModels;

@model CasinoHoldemPokerReportViewModel

@{
    ViewData["Title"] = "Casino Holdem Poker";
}

@section Styles {
    <link href="~/css/report.min.css" rel="stylesheet" asp-append-version="true" />
}
<form class="form filter" data-ajax="true" data-ajax-method="GET" asp-action="GetCasinoHoldemPokerReport" data-ajax-mode="replace" data-ajax-update="#report-result"
      data-ajax-loading="#spinner"
      method="get"
      data-ajax-success="report.onSuccess">
    <div class="form-row align-items-center">
        <div class="col-auto">
            <label class="required" asp-for="PartnerId"></label>
            <select asp-items="@Model.Selections.Partners" asp-for="PartnerId" class="form-control">
                <option selected="selected" value="">All</option>
            </select>
        </div>
        <div class="col-auto">
            <label asp-for="FromDate" class="control-label"></label>
            <input type="date" class="form-control" asp-for="FromDate">
        </div>
        <div class="col-auto">
            <label asp-for="ToDate" class="control-label"></label>
            <input type="date" class="form-control" asp-for="ToDate">
        </div>
        <div class="col-auto">
            <label asp-for="RoundId" class="control-label"></label>
            <input type="number" class="form-control" asp-for="RoundId" />
        </div>
        <div class="col-auto">
            <label asp-for="Nickname" class="control-label"></label>
            <input type="text" class="form-control" placeholder="Nickname" asp-for="Nickname" />
        </div>
        <div class="col-auto">
            <label asp-for="Username" class="control-label"></label>
            <input type="text" class="form-control" placeholder="Username" asp-for="Username" />
        </div>
        <div class="col-auto mt-5">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="ConvertToUSD" />
                <label class="form-check-label" asp-for="ConvertToUSD">
                </label>
            </div>
        </div>
        <div class="col-auto mt-5">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" asp-for="ExcludeUUS" />
                <label class="form-check-label" asp-for="ExcludeUUS">
                </label>
            </div>
        </div>
        <div class="col-auto mt-5">
            <button type="submit" class="btn-submit">Submit</button>
            <div id="spinner" class="spinner-border" style="display: none">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
    </div>
</form>

<div id="report-result" class="col-sm-12 report-container">
</div>


@section Scripts {
    <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
    <script src="~/lib/data-tables/datatables.js"></script>
    <script src="~/js/casino-holdem-poker-report.js" asp-append-version="true"></script>
}
