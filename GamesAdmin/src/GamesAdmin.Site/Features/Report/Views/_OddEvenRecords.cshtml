@using GamesAdmin.Core;
@using GamesAdmin.Site.Features.Report.ViewModels;

@model OddEvenReportResultViewModel

@{
    var evenRecords = Model.Records.Where(x => x.Select).ToList();
    var oddRecords = Model.Records.Where(x => !x.Select).ToList();
    var totalRow = evenRecords.Count > oddRecords.Count ? evenRecords.Count : oddRecords.Count;
    var round = Model.RoundResult;
}

<div class="row">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Results</th>
                        <th>Total</th>
                        <th>Winning Options</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center">
                            <div class="dice-list">
                                <img class="dice" src="~/images/dice_@(Model.RoundResult.Dice1).png" />
                                <img class="dice" src="~/images/dice_@(Model.RoundResult.Dice2).png" />
                                <img class="dice" src="~/images/dice_@(Model.RoundResult.Dice3).png" />
                            </div>
                        </td>
                        <td class="text-center">@Model.RoundResult.Total</td>
                        <td class="text-center">@(Model.RoundResult.IsEven ? "Even": "Odd")</td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th colspan="8" class="big-small-title">Even</th>
                    <th class="line-cell"></th>
                    <th colspan="8" class="big-small-title">Odd</th>
                </tr>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Partner</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                    <th class="line-cell"></th>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-partner">Partner</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-currency">Currency</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Refund</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < totalRow; i++)
                {
                    var evenRecord = evenRecords.ElementAtOrDefault(i);
                    var oddRecord = oddRecords.ElementAtOrDefault(i);
                    <tr>
                        <td>@evenRecord?.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@evenRecord?.Partner</td>
                        <td>@evenRecord?.Username</td>
                        <td>
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetOddEvenBetHistory" asp-route-roundId="@Model.RoundResult.Number" asp-route-nickname="@evenRecord?.Nickname">
                                @evenRecord?.Nickname
                            </a>
                        </td>
                        <td>@evenRecord?.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(evenRecord?.BaseBetAmount))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(evenRecord?.BaseBack))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(evenRecord?.BaseBetWin))</td>
                        <td class="line-cell"></td>
                        <td>@oddRecord?.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@oddRecord?.Partner</td>
                        <td>@oddRecord?.Username</td>
                        <td class="col-nickname">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetOddEvenBetHistory" asp-route-roundId="@Model.RoundResult.Number" asp-route-nickname="@oddRecord?.Nickname">
                                @oddRecord?.Nickname
                            </a>
                        </td>
                        <td>@oddRecord?.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(oddRecord?.BaseBetAmount))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(oddRecord?.BaseBack))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(oddRecord?.BaseBetWin))</td>
                    </tr>

                }
            </tbody>
            <tfoot>
                @if (totalRow == 0)
                {
                    <tr>
                        <td class="text-center" colspan="13">No data</td>
                    </tr>
                }
                else
                {
                    <tr class="total">
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(evenRecords.Sum(x => x.BaseBetAmount)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(evenRecords.Sum(x => x.BaseBack)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(evenRecords.Sum(x => x.BaseBetWin)))</td>
                        <td class="line-cell"></td>
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(oddRecords.Sum(x => x.BaseBetAmount)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(oddRecords.Sum(x => x.BaseBack)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(round.ConvertByExchangeRate(oddRecords.Sum(x => x.BaseBetWin)))</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>