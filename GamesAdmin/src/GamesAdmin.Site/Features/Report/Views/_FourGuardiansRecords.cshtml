@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model FourGuardiansReportResultViewModel

<div class="row">
    <div class="col-sm-12">
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-nickname">Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-number">Round</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Payline</th>
                    <th class="col-number">Total Stake</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {

                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@bet.Username</td>
                        <td>@bet.Nickname</td>
                        <td class="text-center">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetFourGuardiansBetHistory"
                               asp-route-roundId="@bet.RoundId"
                               asp-route-nickname="@bet.Nickname"
                               asp-route-game="@bet.Game">
                                @bet.RoundId
                                @if (bet.SettlementResult.Jackpot != null)
                                {
                                    <img src="~/images/slot-icons/@bet.IconsFolder/history_jackpot.png" />
                                }
                            </a>
                        </td>
                        <td class="text-right">@HtmlHelpers.formatNumber(bet.Bet)</td>
                        <td class="text-center">@bet.Paylines.Count()</td>
                        <td class="text-right">@(bet.FreeSpin ? "0" : HtmlHelpers.formatNumber(bet.TotalAmount))</td>
                        <td class="text-right">
                            @if (bet.Paid)
                            {
                                @HtmlHelpers.formatNumber(bet.TotalBetWin)
                            }
                            else
                            {
                                @("Running")
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td class="text-center" colspan="10">No data</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>