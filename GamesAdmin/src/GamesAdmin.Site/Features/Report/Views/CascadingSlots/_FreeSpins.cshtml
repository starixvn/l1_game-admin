@using GamesAdmin.Site.Features.Report.ViewModels;
@using GamesAdmin.Core;

@model FreeSpinsViewModel
@{
    var tumble = Model.Tumble;
    var freeSpins = Model.FreeSpins;
}

@{   
    <tr>
        <td rowspan="1">@(Model.RowIndex+1)</td>
        <td rowspan="1"> @await Html.PartialAsync("CascadingSlots/_Board", new GenerateBoardViewModel(tumble, Model.SymbolUrl))</td>
        @if (Model.HasOdds)
        {
            <td>
                <img class="symbol" src="@Model.SymbolUrl-@(CascadingSlotGameConstant.FreeSpinSymbol.ToString()).png" />
            </td>
            <td>@freeSpins.Count</td>
            <td>@freeSpins.Odds @Model.FreeSpinsText</td>
        }
        else
        {
            <td colspan="2">-</td>
            <td>0</td>
        }

        <td rowspan=1>@Model.DisplayTumbleWin</td>
    </tr>   
}
