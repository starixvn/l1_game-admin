@using System.Text;
@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels
@model CascadingSlotBetHistoryViewModel
@{
    var imageFolder = Model.Game.ToLowerInvariant();
    var roundResult = Model.Round;
}

@functions {
    public string RenderBoard(IEnumerable<byte> board, string folder, IEnumerable<byte> multipliers)
    {
        var sb = new StringBuilder("<table class='table-result-board'><tbody>");
        var iconPerCol = 5;
        var indexMultiplier = 0;
        var tempMultiplier = multipliers.ToList();
        var rows = new string[] { "<tr>","<tr>","<tr>","<tr>","<tr>"};

        foreach (var item in board.Select((value, index) => new { index, value }))
        {
            if (item.value >= 10)
            {
                rows[item.index % iconPerCol] += "<td class='result-board'>" + GetImageMultiplier(tempMultiplier[indexMultiplier], folder) + "</td>";
                indexMultiplier++;
            }
            else
            {
                rows[item.index % iconPerCol] += "<td>" + RenderSymbol(item.value, folder) + "</td>";
            }
        }
        foreach(var row in rows)
        {
            sb.Append(row);
            sb.Append("</tr>");
        }
        sb.Append("</tbody></table>");

        return sb.ToString();
    }

    public string RenderSymbol(byte value, string folder)
    {
        return "<img class='symbol' src='/images/slot-icons/" + folder + "/" + value + ".png' />";
    }

    public string GetImageMultiplier(byte value, string folder)
    {
        var sb = new StringBuilder("<img class='symbol' src='/images/slot-icons/");
        sb.Append(folder);
        var imgae = "/10";
        if (value <= 10)
        {
            imgae = "/13";
        }
        else
        {
            if (value <= 20)
            {
                imgae = "/11";
            }
            else
            {
                if (value <= 30)
                {
                    imgae = "/12";
                }
            }
        }
        sb.Append(imgae + ".png' />");
        sb.Append("<div class='multiplier " + folder + "'>x" + value + "</div>");
        return sb.ToString();
    }
}
<table class="table table-bordered table-cascading-slot">
    <thead>
        <tr>
            <th class="col-round-id">Round Id</th>
            <th class="col-date">Time</th>
            <th>Bet Level</th>
            <th>Coin Value</th>
            <th>Stake</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @roundResult.RoundId
            <div>@(roundResult.FreeSpin ? "(Free Spin)": string.Empty)</div>
        </td>
        <td>
            @roundResult.Time.ToString(Constants.DateTimeFormat)
        </td>
        <td>@roundResult.BetLevel</td>
        <td>@HtmlHelpers.formatNumber(roundResult.CoinValue)</td>
        <td>@HtmlHelpers.formatNumber(roundResult.TotalAmount)</td>
        <td>@HtmlHelpers.formatNumber(roundResult.BetWin)</td>
    </tr>
    <tr>
        <td colspan="4" class="text-right">Total</td>
        <td>@HtmlHelpers.formatNumber(roundResult.FreeSpin ? 0 : roundResult.TotalAmount)</td>
        <td>@HtmlHelpers.formatNumber(roundResult.BetWin)</td>
    </tr>
    <tr class="total">
        <td colspan="4" class="text-right">Win Loss</td>
        <td></td>
        <td>@HtmlHelpers.formatNumber(roundResult.WinLoss)</td>
    </tr>
</tbody>
</table>

<table class="table table-bordered table-cascading-slot">
    <thead>
        <tr>
            <th>No.</th>
            <th>Result Board</th>
            <th colspan="2">Win Symbols</th>
            <th>Win amount</th>
            <th>Tumble Win</th>
        </tr>
    </thead>
    <tbody>
        @{
            var tumbles = roundResult.SettlementResult.Tumbles.ToList();
            decimal tumbleWin = 0;
            for (byte index = 0; index < tumbles.Count; index++)
            {
                var rowspan = tumbles[index].Icons.Keys.Count > 0 ? tumbles[index].Icons.Keys.Count : 1;
                tumbleWin += tumbles[index].Win;
                if (tumbles[index].Icons.Any())
                {
                    foreach (var item in tumbles[index].Icons.Keys.Select((key, i) => new { index = i, key }))
                    {
                        if (item.index == 0)
                        {
                            <tr>
                                <td rowspan="@rowspan">@(index+1)</td>
                                <td rowspan="@rowspan">@Html.Raw(RenderBoard(tumbles[index].Board, imageFolder, tumbles[index].Multipliers))</td>
                                <td>@Html.Raw(RenderSymbol(item.key, imageFolder))</td>
                                <td>@tumbles[index].Icons[item.key].Count</td>
                                <td>@HtmlHelpers.formatNumber(tumbles[index].Icons[item.key].Win)</td>
                                <td rowspan="@rowspan">@HtmlHelpers.formatNumber(tumbleWin)</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>@Html.Raw(RenderSymbol(item.key, imageFolder))</td>
                                <td>@tumbles[index].Icons[item.key].Count</td>
                                <td>@HtmlHelpers.formatNumber(tumbles[index].Icons[item.key].Win)</td>
                            </tr>
                        }

                    }
                }
                else
                {
                    if (roundResult.FreeSpin)
                    {
                        var additionalFreeSpins = roundResult.SettlementResult.FreeSpins;
                        if (additionalFreeSpins != null && additionalFreeSpins.Odds > 0)
                        {
                            <tr>
                                <td rowspan="@rowspan">@(index+1)</td>
                                <td rowspan="@rowspan">@Html.Raw(RenderBoard(tumbles[index].Board, imageFolder, tumbles[index].Multipliers))</td>
                                <td>@Html.Raw(RenderSymbol(9, imageFolder))</td>
                                <td>@additionalFreeSpins.Count</td>
                                <td>@additionalFreeSpins.Odds Extra Free Spins</td>
                                <td rowspan="@rowspan">@HtmlHelpers.formatNumber(tumbleWin)</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td rowspan="@rowspan">@(index+1)</td>
                                <td rowspan="@rowspan">@Html.Raw(RenderBoard(tumbles[index].Board, imageFolder, tumbles[index].Multipliers))</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td rowspan="@rowspan">@HtmlHelpers.formatNumber(tumbleWin)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        var freeSpins = roundResult.SettlementResult.FreeSpins;
                        if (freeSpins.Odds > 0)
                        {
                            <tr>
                                <td rowspan="@rowspan">@(index+1)</td>
                                <td rowspan="@rowspan">@Html.Raw(RenderBoard(tumbles[index].Board, imageFolder, tumbles[index].Multipliers))</td>
                                <td>@Html.Raw(RenderSymbol(9, imageFolder))</td>
                                <td>@freeSpins.Count</td>
                                <td>@freeSpins.Odds Free Spins</td>
                                <td rowspan="@rowspan">@HtmlHelpers.formatNumber(tumbleWin)</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td rowspan="@rowspan">@(index+1)</td>
                                <td rowspan="@rowspan">@Html.Raw(RenderBoard(tumbles[index].Board, imageFolder, tumbles[index].Multipliers))</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td rowspan="@rowspan">@HtmlHelpers.formatNumber(tumbleWin)</td>
                            </tr>
                        }
                    }
                }
            }
            @if (roundResult.BetWin > 0 && (roundResult.TotalMultiplier > 0 || roundResult.Multiplier > 0))
            {
                <tr>
                    <td colspan="5" class="text-right">Total Multiplier</td>
                    <td>@(roundResult.FreeSpin ? roundResult.TotalMultiplier : roundResult.Multiplier)</td>
                </tr>
            }
            <tr>
                <td colspan="5" class="text-right">@(roundResult.ReachMaxWin ? "(You reached the Max Win) Win" : "Win")</td>
                <td>@HtmlHelpers.formatNumber(roundResult.BetWin)</td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Multipliers != null && Model.Multipliers.Any())
{
    <strong>Total Multiplier</strong>
    <table class="table table-bordered table-cascading-slot">
        <thead>
            <tr>
                <th>No.</th>
                <th>Time</th>
                <th>Round id</th>
                <th>Multiplier</th>
                <th>Total Multiplier</th>
            </tr>
        </thead>
        <tbody>
            @{
                var multipliers = Model.Multipliers.ToList();
                for (byte i = 0; i < multipliers.Count; i++)
                {
                    <tr>
                        <td>@(i+1)</td>
                        <td>@multipliers[i].Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@multipliers[i].RoundId</td>
                        <td>@multipliers[i].Multiplier</td>
                        <td>@multipliers[i].TotalMultiplier</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
