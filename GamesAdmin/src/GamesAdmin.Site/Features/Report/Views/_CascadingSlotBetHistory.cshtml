@using System.Text;
@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels
@model CascadingSlotRecordViewModel
@{
    var imageFolder = Model.Game.ToLowerInvariant();
    var baseWinning = Model.WinningSymbols[0];
    var i = 0;
}

@functions {
    public string RenderBoard(IEnumerable<byte>
    board, string imageFolder)
    {
        var sb = new StringBuilder();
        var iconPerRow = 6;
        var col = iconPerRow;

        foreach (var b in board)
        {
            if (col == 1)
            {
                sb.AppendLine("<br />");
                col = iconPerRow;
            }

            sb.AppendLine("<img class='small-symbol' src='/images/slot-icons/" + imageFolder + "/" + b + ".png' />");
            col--;
        }

        return sb.ToString();
    }
}

<table class="table table-bordered table-cascading-slot">
    <thead>
        <tr>
            <th class="col-date">Time</th>
            <th class="col-round-id">Round Id</th>
            <th>Bet Level</th>
            <th>Coin Value</th>
            <th>Total Stake</th>
            <th>Total Win</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="text-center">
                @Model.Time.ToString(Constants.DateTimeFormat)
            </td>
            <td class="text-center">@Model.RoundId</td>
            <td class="text-center">@Model.BetLevel</td>
            <td class="text-center">@Model.CoinValue</td>
            <td class="text-center">@Model.TotalAmount</td>
            <td class="text-center">@Model.BetWin</td>
        </tr>
    </tbody>
</table>

<table class="table table-bordered table-cascading-slot">
    <thead>
        <tr>
            <th>No.</th>
            <th>Type</th>
            <th>Board</th>
            <th>Symbol</th>
            <th>Number of Symbol</th>
            <th>Win Amount</th>
            <th>Tumble Win</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.WinningSymbols[0])
        {
            if (i == 0)
            {
                <tr>
                    <td rowspan="@baseWinning.Count" class="text-center">1</td>
                    <td rowspan="@baseWinning.Count" class="text-center">Spin</td>
                    <td rowspan="@baseWinning.Count" class="text-center">@Html.Raw(RenderBoard(Model.BaseSpin, imageFolder))</td>
                    <td class="text-center"><img class="symbol" src="~/images/slot-icons/@imageFolder/@(b.Key).png" /></td>
                    <td class="text-center">@b.Value</td>
                    <td class="text-center">
                        @HtmlHelpers.formatNumber((decimal)Model.WinningAmounts[0][b.Key])
                    </td>
                    <td rowspan="@baseWinning.Count" class="text-center">
                        @(Model.Multipliers[0] > 1 ? "Multiplier X" + Model.Multipliers[0] : "")
                        <br />
                        @HtmlHelpers.formatNumber((decimal)Model.TumblingWins[0])
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td class="text-center"><img class="symbol" src="~/images/slot-icons/@imageFolder/@(b.Key).png" /></td>
                    <td class="text-center">@b.Value</td>
                    <td class="text-center">
                        @HtmlHelpers.formatNumber((decimal)Model.WinningAmounts[0][b.Key])
                    </td>
                </tr>
            }

            i++;
        }

        @for (var j = 1; j < Model.WinningSymbols.Count; j++)
        {
            var w = Model.WinningSymbols[j];
            var multiplier = Model.Multipliers[j];
            var tw = multiplier > 1 ? Model.TumblingWins[j] * multiplier : Model.TumblingWins[j];

            if (w == null)
            {
                <tr>
                    <td class="text-center">@(j+1)</td>
                    <td class="text-center">Tumbling</td>
                    <td class="text-center">@Html.Raw(RenderBoard(Model.Tumblings[j - 1], imageFolder))</td>
                    <td class="text-center">-</td>
                    <td class="text-center">-</td>
                    <td class="text-center">-</td>
                    <td class="text-center">
                        @(multiplier > 1 ? "Multiplier X" + multiplier : "")
                        <br />
                        @HtmlHelpers.formatNumber((decimal)tw)
                        @(multiplier > 1 ? " = " + HtmlHelpers.formatNumber((decimal)Model.TumblingWins[j]) + " * " + multiplier : "")
                    </td>
                </tr>
                continue;
            }

            i = 0;

            @foreach (var b in w)
            {
                if (i == 0)
                {
                    <tr>
                        <td rowspan="@w.Count" class="text-center">@(j+1)</td>
                        <td rowspan="@w.Count" class="text-center">Tumbling</td>
                        <td rowspan="@w.Count" class="text-center">@Html.Raw(RenderBoard(Model.Tumblings[j - 1], imageFolder))</td>
                        <td class="text-center"><img class="symbol" src="~/images/slot-icons/@imageFolder/@(b.Key).png" /></td>
                        <td class="text-center">@b.Value</td>
                        <td class="text-center">
                            @HtmlHelpers.formatNumber(w[b.Key])
                        </td>
                        <td rowspan="@baseWinning.Count" class="text-center">
                            @(multiplier > 1 ? "Multiplier X" + multiplier : "")
                            <br />
                            @HtmlHelpers.formatNumber((decimal)tw)
                            @(multiplier > 1 ? " = " + HtmlHelpers.formatNumber((decimal)Model.TumblingWins[j]) + " * " + multiplier : "")
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td class="text-center"><img class="symbol" src="~/images/slot-icons/@imageFolder/@(b.Key).png" /></td>
                        <td class="text-center">@b.Value</td>
                        <td class="text-center">
                            @HtmlHelpers.formatNumber((decimal)w[b.Key])
                        </td>
                    </tr>
                }

                i++;
            }
        }
        <tr>
            <td colspan="6" class="text-right">Total Win</td>
            <td class="text-center">@HtmlHelpers.formatNumber((decimal)Model.TotalWin)</td>
        </tr>
    </tbody>
</table>
