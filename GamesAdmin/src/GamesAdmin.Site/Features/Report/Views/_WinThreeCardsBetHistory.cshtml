@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels
@model WinThreeCardsBetHistoryViewModel

@{
    void RenderBet(string choice)
    {
        var stake = Model.Bet.GetValueBet(choice);
        if (stake == 0)
        {
            return;
        }
        var oddsName = choice.Substring(0, 1).ToLower() + choice.Substring(1);
        <tr>
            <td>@Model.Bet.Time.ToString(Constants.DateTimeFormat)</td>
            <td>@choice</td>
            <td>@Model.Odds[oddsName]</td>
            <td>@HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.Bet.ConvertToBase(stake) / Model.BaseCurrencyMultiplier : stake)</td>
            <td>
                @if (Model.RoundResult.SettlementResult[oddsName])
                {
                    <span>@HtmlHelpers.formatNumber(Model.ConvertToUSD ? Model.Bet.ConvertToBase(Model.Odds[oddsName] * stake) / Model.BaseCurrencyMultiplier : Model.Odds[oddsName] * stake)</span>
                }
                else
                {
                    <span>0</span>
                }
            </td>
        </tr>
    }
}
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Time</th>
            <th>Bet Choice</th>
            <th>Odds</th>
            <th>Stake</th>
            <th>Win</th>
        </tr>
    </thead>
    <tbody>
        @{
            RenderBet("Dragon");
            RenderBet("Phoenix");
            RenderBet("Pair8Plus");
            RenderBet("Straight");
            RenderBet("Flush");
            RenderBet("StraightFlush");
            RenderBet("ThreeOfAKind");
        }
    </tbody>
</table>