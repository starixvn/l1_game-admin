@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model ThreeCardsReportResultViewModel

<div class="row">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered  table-hover table-three-cards" style="width:100%">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Exchange ID</th>
                        <th>Results</th>
                        <th>Winning Options</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">@Model.RoundResult.ExchangeRateId</td>
                        <td class="text-center threecards-result">
                            <div class="cards">
                                @foreach (var card in Model.RoundResult.Result)
                                {
                                    <div class="card card-type-@card.Suit">
                                        <span>@card.Rank</span>
                                        <img class="img" src="~/images/card_@(card.Suit).png" />
                                    </div>
                                }
                            </div>
                        </td>
                        <td class="text-center">
                            @(Model.RoundResult.SettlementResult.Red ? "Red" : "Black")
                            @if (Model.RoundResult.SettlementResult.Diamonds)
                            {
                                <img class="img card-suit" src="~/images/card_1.png" />
                            }
                            @if (Model.RoundResult.SettlementResult.Hearts)
                            {
                                <img class="img card-suit" src="~/images/card_0.png" />
                            }
                            @if (Model.RoundResult.SettlementResult.Spades)
                            {
                                <img class="img card-suit" src="~/images/card_3.png" />
                            }
                            @if (Model.RoundResult.SettlementResult.Clubs)
                            {
                                <img class="img card-suit" src="~/images/card_2.png" />
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th rowspan="2">Round ID</th>
                    <th rowspan="2" class="col-date">Date (GMT+7)</th>
                    <th rowspan="2">Partner</th>
                    <th rowspan="2">Username</th>
                    <th rowspan="2" class="col-nickname">Nickname</th>
                    <th rowspan="2">Currency</th>
                    <th colspan="6" class="col-number">Stake</th>
                    <th rowspan="2" class="col-number">Win</th>
                </tr>

                <tr>
                    <th>Red</th>
                    <th>Black</th>
                    <th>Diamonds</th>
                    <th>Hearts</th>
                    <th>Spades</th>
                    <th>Clubs</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {
                    <tr>
                        <td class="text-center">
                            @Model.RoundResult.Number
                        </td>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">@bet.Partner</td>
                        <td>@bet.Username</td>
                        <td>
                            @bet.Nickname
                        </td>
                        <td class="text-center">@bet.Currency</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Red) : bet.Red)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Black) : bet.Black)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Diamonds) : bet.Diamonds)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Hearts) : bet.Hearts)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Spades) : bet.Spades)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.ConvertToBase(bet.Clubs) : bet.Clubs)</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.ConvertToUSD ? bet.BaseBetWin : bet.BetWin)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @if (!Model.Records.Any())
                {
                    <tr>
                        <td class="text-center" colspan="13">No data</td>
                    </tr>
                }
                else
                {
                    <tr class="total">
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Red)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Black)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Diamonds)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Hearts)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Spades)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.ConvertToBase(x.Clubs)))</td>
                        <td class="text-right">@HtmlHelpers.formatNumber(Model.Records.Sum(x => x.BaseBetWin))</td>
                    </tr>
                }
            </tfoot>
        </table>
    </div>
</div>