@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model SicBoReportResultViewModel

<div class="row">
    <div class="col-sm-12">
        @if (Model.RoundResult.Number != 0)
        {
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Round ID</th>
                        <th>Result</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-center">@Model.RoundResult.Number</td>
                        <td class="text-center">
                            <div class="dice-list">
                                @foreach (var dice in Model.RoundResult.Result)
                                {
                                    <img class="dice" src="~/images/dice_@(dice).png" />
                                }
                            </div>
                        </td>
                        <td class="text-center">@Model.RoundResult.Result.Sum(x => x)</td>
                    </tr>
                </tbody>
            </table>
        }
        <table class="table table-bordered table-hover sticky-table">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th class="col-nickname">Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-number">Total Bets</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.Records)
                {
                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@bet.Username</td>
                        <td>
                            @bet.Nickname
                        </td>
                        <td class="text-right">
                            <a data-ajax="true" data-ajax-method="GET" data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                               asp-action="GetSicBoBetHistory" asp-route-roundId="@Model.RoundResult.Number" asp-route-userId="@bet.UserId">
                                @HtmlHelpers.formatNumber(bet.TotalBet)
                            </a>
                        </td>
                        <td class="text-right">@HtmlHelpers.formatNumber(bet.BetWin)</td>
                    </tr>
                }

                @if (!Model.Records.Any())
                {
                    <tr>
                        <td class="text-center" colspan="5">No data</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>