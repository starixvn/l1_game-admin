@using GamesAdmin.Site.Features.Report.ViewModels;
@using GamesAdmin.Core;
@model TexasHoldemPokerBetHistoryViewModel

@{
    string noData = "No Data Available";
    string unfinishedGame = "Unfinished Game";
    var record = Model.Record;
}

<div>
    @await Html.PartialAsync("_HoldemPokerBetHistoryCards", record)

    <div class="mt-5">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Time (GMT + 7)</th>
                    <th>Bet Choice</th>
                    <th>Odds</th>
                    <th>Stake</th>
                    <th>Win</th>
                </tr>
            </thead>
            <tbody>
                @if (record.Ante > 0)
                {
                    var winAnte = (record.SettlementResult?.Ante ?? 0);
                    var winCall = (record.SettlementResult?.Call ?? 0);
                    var winTurn = (record.SettlementResult?.Turn ?? 0);
                    var winRiver = (record.SettlementResult?.River ?? 0);
                    <tr class="@(winAnte > 0 ? "text-blue bold" : "")">
                        <td class="text-center">@record.Time.ToString(Constants.DateTimeFormat)</td>
                        <td class="text-center">Ante</td>
                        <td class="text-center">@record.AnteOdds</td>
                        <td class="text-center">@HtmlHelpers.formatNumber(record.Ante)</td>
                        @if (record.Ended)
                        {
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(winAnte)
                            </td>
                        }
                        else
                        {
                            <td class="text-center">@unfinishedGame</td>
                        }
                    </tr>
                    @if (record.Ended)
                    {
                        <tr class="@(winCall > 0 ? "record-blue bold" : "")">
                            <td class="text-center">@record.CallTime.ToString(Constants.DateTimeFormat)</td>
                            <td class="text-center">Call</td>
                            <td class="text-center">@record.CallOdds</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(record.Call)</td>
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(winCall)
                            </td>
                        </tr>
                        <tr class="@(winCall > 0 ? "text-blue bold" : "")">
                            <td class="text-center">@record.TurnTime.ToString(Constants.DateTimeFormat)</td>
                            <td class="text-center">Turn</td>
                            <td class="text-center">@record.TurnOdds</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(record.Turn)</td>
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(winTurn)
                            </td>
                        </tr>
                        <tr class="@(winCall > 0 ? "text-blue bold" : "")">
                            <td class="text-center">@record.RiverTime.ToString(Constants.DateTimeFormat)</td>
                            <td class="text-center">River</td>
                            <td class="text-center">@record.RiverOdds</td>
                            <td class="text-center">@HtmlHelpers.formatNumber(record.River)</td>
                            <td class="text-center">
                                @HtmlHelpers.formatNumber(winRiver)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            @noData
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

