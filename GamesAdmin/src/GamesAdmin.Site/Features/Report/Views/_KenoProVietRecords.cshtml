@using GamesAdmin.Core
@using GamesAdmin.Site.Features.Report.ViewModels;

@model KenoReportViewModel

<div class="row">
    <div class="col-sm-12">
        @if (Model.RoundResult.Results?.Length > 0)
        {
            <h3 class="round-result">Round Result: <span class="result">@Model.RoundResult.Results[0];</span> </h3>
        }
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th class="col-date">Date (GMT+7)</th>
                    <th>Username</th>
                    <th class="col-nickname">Nickname</th>
                    <th class="col-number">Stake</th>
                    <th class="col-number">Win</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bet in Model.BetTickets)
                {

                    <tr>
                        <td>@bet.Time.ToString(Constants.DateTimeFormat)</td>
                        <td>@bet.Username</td>
                        <td>
                            @*<a data-ajax="true" data-ajax-method="GET"  data-ajax-mode="replace" data-ajax-update="#modal .modal-body" data-ajax-success="showModal('#modal')"
                                   asp-action="GetBigSmallBetHistory" asp-route-roundId="@Model.RoundResult.Number" asp-route-nickname="@bigRecord?.Nickname"
                                >*@
                            @bet.Nickname
                            @*</a>*@
                        </td>
                        <td class="text-right">@bet.BetWin</td>
                    </tr>

                }
            </tbody>
            <tfoot>
                @if (Model.Total == 0)
                {
                    <tr>
                        <td class="text-center" colspan="13">No data</td>
                    </tr>
                }
                else
                {
                    @*<tr class="total">
                            <td>Total</td>
                            <td></td>
                            <td></td>
                            <td class="text-right">@bigRecords.Sum(x => x.Bet)</td>
                            <td class="text-right">@bigRecords.Sum(x => x.Back)</td>
                            <td class="text-right">@bigRecords.Sum(x => x.BetWin)</td>
                            <td class="line-cell"></td>
                        </tr>*@
                }
            </tfoot>
        </table>
    </div>
</div>