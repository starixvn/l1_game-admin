@using GamesAdmin.Site.Features.OperateSettings.ViewModels
@using GamesAdmin.Site.Features._Shared
@model CurrencyGroupGameSettingViewModel
@{
    Layout = "../_Shared/_BodyLayout";
    var exportModel = Model.BuildExportModel();
}
@section Styles {
    <link rel="stylesheet" href="~/scss/pages/currency-group-game-operations.css" asp-append-version="true" />
}

<div class="container-fluid">
    <div class="mb-3">
        @if (Context.HasAdminPermission())
        {
            <button id="exportSelected" class="btn btn-add export-button">
                Export Selected Currency Group Games
            </button>
            <input type="file" id="fileInput" accept=".json" style="display: none;" />
            <button id="importCurrencyGroupGames" class="btn btn-submit export-button">
                Import Currency Group Games
            </button>
        }
    </div>


    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th class="align-top text-center">
                        <input type="checkbox" id="selectAll" />
                    </th>
                    <th class="align-top text-center">Operator Id</th>
                    <th class="align-top text-center">Group Name</th>
                    <th class="align-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Game Setting</span>
                            <div class="btn-group btn-group-sm" role="group" title="Toggle visibility of game settings details">
                                <button id="expandAll" class="btn btn-outline-primary btn-sm" title="Expand all game settings to view details">
                                    <i class="icon-expand-more"></i><span>Expand All</span>
                                </button>
                                <button id="collapseAll" class="btn btn-outline-primary btn-sm" title="Collapse all game settings to show summary only">
                                    <i class="icon-expand-less"></i><span>Collapse All</span>
                                </button>
                            </div>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var currencyGroup in exportModel)
                {
                    <tr>
                        <td class="align-top text-center">
                            <input type="checkbox" class="export-select" data-group-id="@currencyGroup.OperatorId" />
                        </td>
                        <td class="align-top text-center">@currencyGroup.OperatorId</td>
                        <td class="align-top text-center">@currencyGroup.CurrencyGroupName</td>
                        <td class="align-top game-setting-cell">
                            <div class="game-setting-summary" data-group-id="@currencyGroup.OperatorId">
                                <div class="summary-header">
                                    <div class="summary-info">
                                        <strong>Game Settings</strong>
                                        <span class="game-count-badge">@currencyGroup.CurrencyGroupGames.Count() games</span>
                                        @if (currencyGroup.CurrencyGroupGames.Any())
                                        {
                                            <div style="margin-top: 5px; font-size: 12px; color: #6c757d;">
                                                @{
                                                    var enabledCount = currencyGroup.CurrencyGroupGames.Count(g => g.Enabled);
                                                    var totalCount = currencyGroup.CurrencyGroupGames.Count();
                                                    var minBet = currencyGroup.CurrencyGroupGames.Min(g => g.MinBet);
                                                    var maxBet = currencyGroup.CurrencyGroupGames.Max(g => g.MaxBet);
                                                }
                                                <span>Enabled: @enabledCount/@totalCount</span>
                                                <span> | Bet Range: @minBet.ToString("F2") - @maxBet.ToString("F2")</span>
                                                @if (currencyGroup.CurrencyGroupGames.Any())
                                                {
                                                    var gameNames = currencyGroup.CurrencyGroupGames.Take(3).Select(g => g.GameName);
                                                    <span> | Games: @string.Join(", ", gameNames)@(totalCount > 3 ? "..." : "")</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <i class="icon-expand-more toggle-icon"></i>
                                </div>
                            </div>
                            <div class="game-setting-details" data-group-id="@currencyGroup.OperatorId">
                                <pre>@Newtonsoft.Json.JsonConvert.SerializeObject(currencyGroup.CurrencyGroupGames.Select(game =>
                                            game), Newtonsoft.Json.Formatting.Indented)</pre>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Add Modal -->
<div class="modal fade" id="importModal" tabindex="-1" role="dialog" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-full" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Review Import Data</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="importDataContainer">
                    <!-- Data will be populated dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmImport">Import</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Export Modal -->
<div class="modal fade" id="exportModal" tabindex="-1" role="dialog" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-full" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportModalLabel">Review Export Data</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="exportDataContainer">
                    <!-- Data will be populated dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirmExport">Export</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/currency-group-game-operations.js" asp-append-version="true"></script>
}