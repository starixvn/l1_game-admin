@model GamesAdmin.Site.Features.Dashboard.ViewModels.DashboardViewModel

@section Styles {
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.20/css/jquery.dataTables.css">
    <link href="~/scss/pages/dashboard.css" rel="stylesheet" asp-append-version="true" />
}

<div class="stats row">
    <div class="stats-item col-sm-6">
        <div class="stats-container">
            <div class="circle yellow">
                <i class="material-icons icon">people_alt</i>
            </div>
            <div class="stats-detail">
                <div class="number" id="online-users">
                    <div id="spinner" class="spinner-border">
                    </div>
                </div>
                <div>Real User</div>
            </div>
        </div>
    </div>
</div>

