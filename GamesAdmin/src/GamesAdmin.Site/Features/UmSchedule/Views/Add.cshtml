@using GamesAdmin.Site.Features.UmSchedule.ViewModels;
@model AddViewModel;

@{
    ViewData["Title"] = "Add New Schedule";
}

<div class="col-md-10 col-lg-6 card">
    @{
        if (!string.IsNullOrWhiteSpace(@Model.ErrorMessage))
        {
            <div class="message-error"><i class="material-icons">cancel</i> @Model.ErrorMessage</div>
        }

        <form class="card-body form" method="post">
            <div class="form-group row">
                <label asp-for="Start" class="control-label"></label>
                <input type="datetime" asp-for="Start" value="@Model.StartDisplay" class="form-control" />
            </div>

            <div class="form-group row">
                <label asp-for="End" class="control-label"></label>
                <input type="datetime" asp-for="End" value="@Model.EndDisplay" class="form-control" />
            </div>

            <div class="form-group row">
                <label asp-for="Message" class="control-label"></label>
                <input type="text" asp-for="Message" class="form-control" />
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Add" class="btn-submit" />
            </div>
        </form>
    }
</div>
