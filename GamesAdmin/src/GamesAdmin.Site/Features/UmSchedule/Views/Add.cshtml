@using GamesAdmin.Site.Features.UmSchedule.ViewModels;
@model AddViewModel;

@{
    ViewData["Title"] = "Add New Schedule";
}

@section Styles {
    <link href="~/lib/jquery-datetimepicker/jquery.datetimepicker.min.css" rel="stylesheet" asp-append-version="true" />
}

<div class="col-md-10 col-lg-6 card">
    @{
        if (!string.IsNullOrWhiteSpace(@Model.ErrorMessage))
        {
            <div class="message-error"><i class="material-icons">cancel</i> @Model.ErrorMessage</div>
        }

        <form class="card-body form" method="post">
            <div class="form-group row">
                <label asp-for="From" class="control-label"></label>
                <input type="text" id="from" asp-for="From" class="form-control" />
            </div>

            <div class="form-group row">
                <label asp-for="To" class="control-label"></label>
                <input type="text" asp-for="To" id="to" class="form-control" />
            </div>

            <div class="form-group row">
                <label asp-for="Message" class="control-label"></label>
                <input type="text" asp-for="Message" class="form-control" />
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Add" class="btn-submit" />
            </div>
        </form>
    }
</div>
@section Scripts
{
    <script src="~/lib/jquery-datetimepicker/jquery.datetimepicker.full.min.js"></script>
    <script>
        $('#from').datetimepicker({
            inline: true
        });

        $('#to').datetimepicker({
            inline: true
        });
    </script>
}

