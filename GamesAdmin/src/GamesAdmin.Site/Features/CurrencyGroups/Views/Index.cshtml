@model GamesAdmin.Site.Features.CurrencyGroups.ViewModels.IndexViewModel

@section Styles {
    <link href="~/css/currency-group.min.css" rel="stylesheet" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Currency Group Management";
}

<form class="form filter" data-ajax="true" data-ajax-method="POST" asp-action="GetCurrencyGroups"
      data-ajax-mode="replace"
      data-ajax-update="#currency-group-management .card-body"
      data-ajax-loading="#spinner"
      data-ajax-success="currencyGroup.init"
      method="post"
      id="currency-group-form">
    <div class="form-group">
        <label asp-for="Partners" class="control-label"></label>
        <select class="form-control" id="partners" asp-items="@Model.PartnerItems" asp-for="Partners" multiple></select>
    </div>
    <div class="form-group">
        <label asp-for="Currencies" class="control-label"></label>
        <select multiple class="form-control" id="currencies" asp-items="@Model.CurencyItems" asp-for="Currencies"></select>
    </div>
    <div class="col-auto list-buttons">
        <button type="submit" class="btn-submit">Submit</button>
        <a class="btn-add"
           data-ajax="true"
           data-ajax-mode="replace"
           data-ajax-update="#modal .modal-content"
           data-ajax-success="currencyGroup.openAddNewCurrencyGroupForm"
           asp-action="Create">
            Add Group
        </a>
        <div id="spinner" class="spinner-border" style="display: none">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
</form>

<div id="currency-group-management" class="card">
    <div class="card-body"></div>
</div>

<div class="modal fade" id="modal" tabindex="-1" role="dialog" aria-labelledby="modal" aria-hidden="true">
    <div class="modal-dialog currency-group-model">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts
{
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script type="text/javascript" src="~/lib/select2/dist/js/select2.full.min.js"></script>
        <script src="~/js/currency-group.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/js/currency-group.min.js" asp-append-version="true"></script>
    </environment>
}