@model GamesAdmin.Site.Features.CurrencyGroups.ViewModels.CurrencyGroupManagementViewModel

<table id="currency-group-table" class="table table-bordered table-hover stripe sticky-table">
    <thead>
        <tr>
            <th>Partner</th>
            <th>Currency Group</th>
            <th>Currency</th>
            <th>Game</th>
            <th>Enabled</th>
            <th>Edit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Models)
        {
            <tr>
                <td class="text-center">@Model.GetPartnerName(item)</td>
                <td class="text-center">@item.Name</td>
                <td class="text-center">@Model.GetCurrenciesSeperatedByComma(item)</td>
                <td class="text-center"></td>
                <td class="text-center">
                    @if (item.Enabled)
                    {
                        <i class="icon-check"></i>
                    }
                    else
                    {
                        <i class="icon-cancel"></i>
                    }
                </td>
                <td class="text-center">
                    <a class="btn-edit"
                       data-ajax="true"
                       data-ajax-mode="replace"
                       data-ajax-update="#modal .modal-content"
                       data-ajax-success="currencyGroup.openUpdateCurrencyGroupForm"
                       asp-route-id=@item.Id
                       asp-action="Update">
                        <i class="icon-edit"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>