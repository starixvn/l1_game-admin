@using GamesAdmin.Site.Features.Notifications.ViewModels;
@model IndexViewModel;

@{
    ViewData["Title"] = "Notifications";
}

<div class="form-row align-items-center">
    <div class="col-auto">
        <a asp-action="Add" asp-controller="Notification" class="add-new-game">
            <i class="material-icons menu-icon">add_alarm</i>
            <span class="menu-name">New Notification</span>
        </a>
    </div>
</div>

<div class="col-md-10 col-lg-6 card">
    <table id="status-tbl" class="table table-bordered">
        <thead>
            <tr>
                <th>Message</th>
                <th>Display As</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>            
            @if (!Model.HasData) 
            {
                <tr>
                    <td colspan="4" align="center">There is no data.</td>
                </tr>
            }

            @foreach (var notification in Model.Notifications)
            {
                <tr>
                    <td>@notification.Message</td>
                    <td>@notification.DisplayKind.DisplayName</td>
                    <td>
                        <a asp-controller="Notification" asp-action="Edit" asp-route-id="@notification.Id">Edit</a> |
                        <a href="#" onclick="DeleteButton('@notification.Id');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts{
    <script src="~/js/Notification.min.js" asp-append-version="true"></script>
}
