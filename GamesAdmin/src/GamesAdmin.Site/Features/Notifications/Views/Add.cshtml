@using GamesAdmin.Site.Features.Notifications.ViewModels;
@model AddViewModel;

@{
    ViewData["Title"] = "Add Notification";
}


<div class="col-md-10 col-lg-6 card">
    @*<div class="col-md-2">
        <a asp-action="Index" asp-controller="Notification" class="btn-gray back-button">
            <i class="material-icons">reply</i>
            Back
        </a>
    </div>*@

    <form class="card-body form" asp-action="Add" asp-controller="Notification" method="post">
        <div class="form-group">
            <label class="control-label">Display As</label>
            <select class="form-control" asp-for="DisplayKindValue" asp-items="Model.DisplayKinds"></select>
        </div>
        <div class="form-group">
            <label class="control-label">Message</label>
            <textarea class="form-control" asp-for="Message"> </textarea>
        </div>
        <div class="form-group">
            <a asp-action="Index" asp-controller="Notification" class="btn-gray back-button">
                <i class="material-icons">reply</i>
                Back
            </a>

            <input type="submit" value="Add" class="btn-submit" />
        </div>
    </form>
</div>

