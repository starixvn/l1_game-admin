@using GamesAdmin.Site.Features.Users.ViewModels;
@model IndexViewModel;

@{
    ViewData["Title"] = "Users";
}

<div class="card">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>IsAdmin</th>
                    <th>&nbsp;</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Users)
                {
                    <tr>
                        <td>@item.Username</td>
                        <td>@item.IsAdmin</td>
                        <td>
                            <a asp-route-id="@item.Username" asp-action="Delete">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>