@using GamesAdmin.Site.Features.Users.ViewModels;
@model AddViewModel;

@{
    ViewData["Title"] = "Users";
}

<div class="row">
    <div class="col-md-10 col-lg-6 card">
        @if (!string.IsNullOrWhiteSpace(Model?.ErrorMessage))
        {
            <div class="message-error"><i class="material-icons">cancel</i> @Model.ErrorMessage</div>
        }
        <form class="card-body form-add" asp-action="Add" asp-controller="User" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Username" class="control-label"></label>
                <input type="text" asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input type="password" asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="control-label"></label>
                <input type="password" asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div>
                    <input type="checkbox" asp-for="IsAdmin" />
                    <label asp-for="IsAdmin" class="control-label"></label>
                </div>
                <span asp-validation-for="IsAdmin" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Add" class="btn-submit" />
            </div>
        </form>
    </div>
</div>


