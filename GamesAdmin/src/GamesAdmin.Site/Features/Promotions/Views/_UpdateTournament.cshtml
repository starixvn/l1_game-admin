@using GamesAdmin.Core.Enumeration;
@using GamesAdmin.Site.Extensions;
@using GamesAdmin.Site.Features.Promotions.ViewModels;
@using GamesAdmin.Site._Shared.Configurations;
@inject IAppSettings appSetting;
@model PromotionCampaignViewModel;
@{
    var disabledValue = Model.Status.Equals(PromotionCampaignStatus.RunningValue);
}
<div class="modal-header">
    <h5 class="modal-title">Edit Promotion</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<form class="form" data-ajax="true" data-ajax-method="POST" asp-action="UpdateTournament"
      data-ajax-loading="#spinner"
      data-ajax-success="promotion.onUpdatePromotionSuccess"
      data-ajax-failure="promotion.onUpdatePromotionUnsuccess"
      id="add-new-tournament-form">
    <input hidden asp-for="@Model.Status" />
    <input hidden asp-for="@Model.Id" />
    <div class="col-12 mt-3 modal-body">
        <div class="form-group">
            <div class="col-12 row">
                <label class="control-label col-3 pt-3 bold" asp-for="Name">Promotion name:</label>
                <input type="text" class="form-control col-9 bold" asp-for="Name" value="@Model.Name">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>          
        </div>
        <div class="form-group">
            <label class="control-label col-3 pt-3 bold">Start date</label>
            <div class="form-group">
                <div class="col-12 row">
                    <label asp-for="StartDate" class="control-label col-3 pt-3">Date (GMT+7):</label>
                    @if (disabledValue)
                    {
                        <input type="date" class="form-control col-3 mb-3" disabled asp-for="StartDate">
                    }
                    else
                    {
                        <input type="date" class="form-control col-3 mb-3" asp-for="StartDate">
                    }                                     
                </div>
                <div class="col-12 row">
                    <label asp-for="StartTime" class="control-label col-3 pt-3">Time (GMT+7):</label>
                    @if (disabledValue)
                    {
                        <input type="text" class="form-control col-3 time-picker" disabled asp-for="StartTime" value="@Model.StartTime.ToTimeFormat()">
                    }
                    else
                    {
                        <input type="text" class="form-control col-3 time-picker" asp-for="StartTime" value="@Model.StartTime.ToTimeFormat()">
                    }
                    
                </div>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-3 pt-3 bold">End date</label>
            <div class="form-group">
                <div class="col-12 row">
                    <label asp-for="EndDate" class="control-label col-3 pt-3">Date (GMT+7):</label>
                    @if (disabledValue)
                    {
                        <input type="date" class="form-control col-3 mb-3" disabled asp-for="EndDate">
                    }
                    else
                    {
                        <input type="date" class="form-control col-3 mb-3" asp-for="EndDate">
                    }
                   
                </div>
                <div class="col-12 row">
                    <label asp-for="EndTime" class="control-label col-3 pt-3">Time (GMT+7):</label>
                    @if (disabledValue)
                    {
                        <input type="text" class="form-control col-3 time-picker" disabled= asp-for="EndTime" value="@Model.EndTime.ToTimeFormat()">
                    }
                    else
                    {
                        <input type="text" class="form-control col-3 time-picker" asp-for="EndTime" value="@Model.EndTime.ToTimeFormat()">
                    }
                    
                </div>
            </div>
        </div>    
        <fieldset class="form-group mt-3 pb-3">
            <legend>Prize</legend>
            <div id="prize-list" class="form-row">
                @for (var i = 0; i < Model?.WinningPrizes?.Count(); i++)
                {
                    <div class="form-group col-md-2">
                        <label>Ranking</label>
                        <input id="ranking-@i" type="text" asp-for="@Model.WinningPrizes[i].Ranking" value="@Model.WinningPrizes[i].Ranking" class="form-control text-center" />
                    </div>
                    <div class="form-group col-md-3">                       
                        <label>Win Amount</label>
                        <input type="number" asp-for="@Model.WinningPrizes[i].Value" value="@Model.WinningPrizes[i].Value" class="form-control text-center" />
                    </div>
                    <div class="form-group col-md-1">                      
                    </div>
                }
            </div>
           
            <div class="add-container">
                <button type="button" class="btn btn-add" id="addRankingBtn" onclick="promotion.addRanking()">Add more</button>
            </div>
        </fieldset>
        <label class="hidden" id="result-label"></label>
    </div>
    <div class=" modal-footer">
        <button type="button" class="btn-gray" data-dismiss="modal">Close</button>
        <button type="submit" class="btn-submit">Save</button>
    </div>
</form>