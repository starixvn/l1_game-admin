@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model GamesViewModel;

@{
    ViewData["Title"] = "Games";
}
<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th class="text-center">#</th>
            <th>Name</th>
            <th>Enabled</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.GameList)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Enabled</td>
                <td>
                    <form method="post" asp-route-id="@item.Id" asp-action="ToogleOnOff">
                        @if (item.Enabled)
                        {
                            <button>Disable</button>
                        }
                        else
                        {
                            <button>Enable</button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>