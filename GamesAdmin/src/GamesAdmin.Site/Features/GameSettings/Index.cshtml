@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model IndexViewModel;

@{
    ViewData["Title"] = "Games";
}
<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Add" asp-controller="GameConfigs" method="get">
            <div class="form-group">
                <input type="submit" value="Add New" class="btn btn-default btn-primary" />
            </div>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th class="text-center">#</th>
            <th>Name</th>
            <th>MinBet</th>
            <th>MaxBet</th>
            <th>Enabled</th>
            <th>Round</th>
            <th>&nbsp;</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.GameList)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.MinBet</td>
                <td>@item.MaxBet</td>
                <td>@item.Enabled</td>
                <td>@item.DisabledRound</td>
                <td>
                    <a asp-route-id="@item.Id" asp-action="Edit">Edit</a> |
                    <a asp-route-id="@item.Id" asp-action="Delete">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
