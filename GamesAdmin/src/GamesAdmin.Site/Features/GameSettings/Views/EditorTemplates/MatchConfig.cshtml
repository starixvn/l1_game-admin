@using GamesAdmin.Site.Extensions
@using GamesAdmin.Site._Shared.Configurations
@model GamesAdmin.Core.Models.GameConfigs.MatchConfig
@inject IAppSettings appSetting;
@{
    Model.ConvertToTimeZone(appSetting.DefaultTimeZone);
}

<div class="row mt-2 match-item">
    <input type="hidden" asp-for="Id" class="id"/>
    <label asp-for="Home" class="control-label col-1 mt-2 mr-2"></label>
    <input type="text" asp-for="Home" class="form-control col-1 home" />
    <label asp-for="Away" class="control-label col-1 mt-2"></label>
    <input type="text" asp-for="Away" class="form-control col-1 away" />
    <label style="max-width:20%" asp-for="StartTime" class="control-label col-3 mt-2">Start Time (GMT+7)</label>
    <input type="text" asp-for="StartTime" class="form-control col-3 startTime" value="@Model.StartTime.ToDateTimeFormat()">
    <i class="icon-cancel text-error mt-3 ml-2" style="cursor: pointer" onclick="matchConfig.removeMatchItem(event)"></i>
</div>

