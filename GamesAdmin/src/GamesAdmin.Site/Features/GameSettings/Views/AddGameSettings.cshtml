@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@using GamesAdmin.Core.Enumeration;
@model AddViewModel;

@{
    ViewData["Title"] = "Add Game Settings";
}

<div class="col-md-12 col-lg-6 card">
    <form class="card-body form" asp-action="AddGameSettings" asp-controller="GameSettings" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @if (Model.HasError)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error:</strong> @Model.ErrorMessage
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="form-group" id="game-name-container">
            <label asp-for="Name" class="control-label"></label>
            <input type="text" name="NameTextbox" class="form-control" id="name-textbox" placeholder="Enter game name"
                required onblur="validateNameField()" />
            <select name="NameSelect" asp-items="@Model.GameNames" class="form-control" id="name-select" required
                onchange="validateNameField()"></select>
            <input type="hidden" asp-for="Name" id="name-hidden" />
            <span asp-validation-for="Name" class="text-danger"></span>
            <div id="name-validation-error" class="text-danger" style="display:none;">This field is required.</div>
            <small class="form-text text-muted" id="name-helper-text"></small>
        </div>

        <div class="form-group">
            <label asp-for="DisplayName" class="control-label"></label>
            <input type="text" asp-for="DisplayName" class="form-control" placeholder="Enter Game Display Name" />
        </div>

        <div class="form-group" id="game-id-container">
            <label asp-for="GameId" class="control-label"></label>
            <input type="number" asp-for="GameId" class="form-control" id="game-id-input" placeholder="Enter game ID"
                min="1" required onblur="validateGameIdField()" />
            <span asp-validation-for="GameId" class="text-danger"></span>
            <div id="game-id-validation-error" class="text-danger" style="display:none;">Game ID is required and must be
                a positive number.</div>
        </div>

        <div class="form-group row">
            <div class="col-lg-4">
                <input type="checkbox" asp-for="Enabled" />
                <label asp-for="Enabled" class="control-label"></label>
            </div>
            <div class="col-lg-4">
                <input type="checkbox" asp-for="BotEnabled" />
                <label asp-for="BotEnabled" class="control-label"></label>
            </div>
            <div class="col-lg-4">
                <input type="checkbox" asp-for="EnableFreeBet" />
                <label asp-for="EnableFreeBet" class="control-label"></label>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="DelayStartTime" class="control-label"></label>
            <input type="number" asp-for="DelayStartTime" class="form-control" />
        </div>

        <div class="form-group row" id="rng-game">
            <div class="col-lg-6">
                <label asp-for="MinBet" class="control-label"></label>
                <input type="number" asp-for="MinBet" class="form-control" />
            </div>

            <div class="col-lg-6">
                <label asp-for="MaxBet" class="control-label"></label>
                <input type="number" asp-for="MaxBet" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <input type="checkbox" asp-for="ApplyMultiplier" />
            <label asp-for="ApplyMultiplier" class="control-label"></label>
        </div>

        <!-- Manual Choice Input Section -->
        <fieldset id="choices-section">
            <legend>Choice Configuration</legend>
            <div class="form-group">
                <small class="form-text text-muted">Configure choices for different bet options. Add multiple key-value
                    pairs for choice configuration.</small>
            </div>

            <div class="form-group" id="use-different-odds-container">
                <input type="checkbox" id="use-different-odds" asp-for="UseOddsDifferentWithChoice" />
                <label for="use-different-odds">Use different Odds setting with choices</label>
                <small class="form-text text-muted">Check this if you want to configure odds separately from choices.
                    (Eg: Fish Prawn Crab Game)</small>
            </div>

            <div id="choices-container">
                <div class="form-group row choice-row">
                    <div class="col-lg-4">
                        <label class="control-label">Key</label>
                        <input type="text" name="Choices[0].Key" class="form-control choice-key"
                            placeholder="e.g., high, low, red, black" required />
                        <span class="text-danger field-validation-error" data-valmsg-for="Choices[0].Key"
                            data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-lg-4">
                        <label class="control-label">Name</label>
                        <input type="text" name="Choices[0].Name" class="form-control choice-name"
                            placeholder="e.g., High Bet, Low Bet, Red, Black" required />
                        <span class="text-danger field-validation-error" data-valmsg-for="Choices[0].Name"
                            data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-lg-3 odds-column">
                        <label class="control-label">Odds</label>
                        <input type="number" name="Choices[0].Odds" class="form-control choice-odds" step="0.01"
                            min="0.01" placeholder="e.g., 2.0, 1.5" required />
                        <span class="text-danger field-validation-error" data-valmsg-for="Choices[0].Odds"
                            data-valmsg-replace="true"></span>
                    </div>
                    <div class="col-lg-1">
                        <label class="control-label">&nbsp;</label>
                        <button type="button" class="btn btn-danger btn-sm remove-choice-row" style="display:none;">
                            <i class="fa fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="button" class="btn btn-success btn-sm" id="add-choice-row">
                    <i class="fa fa-plus"></i> Add Choice Row
                </button>
            </div>
        </fieldset>

        <!-- Separate Odds Configuration Section -->
        <fieldset id="odds-section" style="display:none;">
            <legend>Odds Configuration</legend>
            <div class="form-group">
                <small class="form-text text-muted">Configure odds settings separately from choices. Add multiple
                    key-value pairs for odds configuration.</small>
            </div>

            <div id="odds-container">
                <div class="form-group row odds-row">
                    <div class="col-lg-4">
                        <label class="control-label">Key</label>
                        <input type="text" name="OddsKeys[0]" class="form-control odds-key"
                            placeholder="e.g., high, low, red, black" />
                    </div>
                    <div class="col-lg-4">
                        <label class="control-label">Name</label>
                        <input type="text" name="OddsDisplayNames[0]" class="form-control odds-name"
                            placeholder="e.g., High Bet, Low Bet, Red, Black" />
                    </div>
                    <div class="col-lg-3">
                        <label class="control-label">Odds</label>
                        <input type="number" name="OddsValues[0]" class="form-control odds-value" step="0.01" min="0.1"
                            placeholder="e.g., 2.0, 1.5" />
                    </div>
                    <div class="col-lg-1">
                        <label class="control-label">&nbsp;</label>
                        <button type="button" class="btn btn-danger btn-sm remove-odds-row" style="display:none;">
                            <i class="fa fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <button type="button" class="btn btn-success btn-sm" id="add-odds-row">
                    <i class="fa fa-plus"></i> Add Odds Row
                </button>
            </div>
        </fieldset>

        <div id="tournament-config" class="form-group" style="display:none;">
            <input id="have-tournament" type="checkbox" asp-for="HaveTournament" />
            <label asp-for="HaveTournament" class="control-label"></label>
        </div>

        <div id="video-stream-config" class="form-group" style="display:none;">
            <input id="have-video-stream" type="checkbox" asp-for="HaveVideoStream" />
            <label asp-for="HaveVideoStream" class="control-label"></label>
        </div>

        <div id="use-margin" class="form-group" style="display:none;">
            <input type="checkbox" asp-for="UseMargin" />
            <label asp-for="UseMargin" class="control-label"></label>
        </div>

        <div id="slot-rng-config" style="display:none;">
            <div class="form-group">
                <label asp-for="Mode" class="control-label"></label>
                <select asp-items="@Model.ModeItems" asp-for="Mode" class="form-control common-field"></select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Type" class="control-label"></label>
            <select asp-items="@Model.GameTypes" asp-for="Type" onchange="gameStatus.toggleGameTypeConfig();"
                class="form-control"></select>
            <input type="hidden" id="initial-game-type" value="@((int)Model.Type)" />
        </div>

        <div id="slots-config" class="slots-game" style="display:none;">
            <div class="form-group">
                <label asp-for="Mode" class="control-label"></label>
                <select asp-items="@Model.ModeItems" asp-for="Mode" class="form-control common-field"></select>
            </div>

            <div class="form-group row">
                <div class="col-lg-6">
                    <label asp-for="NumberOfIcons" class="control-label"></label>
                    <input type="number" asp-for="NumberOfIcons" class="form-control common-field" />
                </div>
                <div class="col-lg-6">
                    <label asp-for="OddsPerIcon" class="control-label"></label>
                    <input type="number" asp-for="OddsPerIcon" class="form-control" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-lg-4">
                    <label class="control-label" asp-for="BigWinRatio"></label>
                    <input type="number" asp-for="BigWinRatio" class="form-control common-field" />
                    <span asp-validation-for="BigWinRatio" class="text-danger"></span>
                </div>
                <div class="col-lg-4">
                    <label class="control-label" asp-for="MegaWinRatio"></label>
                    <input type="number" asp-for="MegaWinRatio" class="form-control common-field" />
                    <span asp-validation-for="MegaWinRatio" class="text-danger"></span>
                </div>
                <div class="col-lg-4">
                    <label class="control-label" asp-for="SuperWinRatio"></label>
                    <input type="number" asp-for="SuperWinRatio" class="form-control common-field" />
                    <span asp-validation-for="SuperWinRatio" class="text-danger"></span>
                </div>
            </div>

            <fieldset>
                <legend>Stake Levels</legend>
                <div class="form-group row">
                    @for (var i = 0; i < Model.Stakes.Length; i++)
                    {
                        <div class="col-lg-4">
                            <label class="control-label">@($"Level {i + 1}")</label>
                            <input type="number" asp-for="@Model.Stakes[i]" class="form-control" />
                        </div>
                    }
                </div>
            </fieldset>
            <br />
            <div class="form-group row">
                <div class="col-lg-6">
                    <input type="checkbox" asp-for="EnableJackpot" onclick="gameStatus.toogleJackpot();" />
                    <label asp-for="EnableJackpot" class="control-label"></label>
                </div>
            </div>

            <fieldset class="slots-jackpot" style="display: none">
                <legend>Jackpot</legend>

                <div class="form-group row">
                    @for (var i = 0; i < Model.Jackpots.Length; i++)
                    {
                        <div class="col-lg-4">
                            <label class="control-label">@($"Level {i + 1}")</label>
                            <input type="number" asp-for="@Model.Jackpots[i]" class="form-control" />
                        </div>
                    }
                </div>

                <div class="form-group row">
                    <div class="col-lg-4">
                        <label class="control-label" asp-for="WinningRatio"></label>
                        <input type="number" asp-for="WinningRatio" class="form-control" />
                        <span asp-validation-for="WinningRatio" class="text-danger"></span>
                    </div>

                    <div class="col-lg-4">
                        <label class="control-label" asp-for="BotJackpotContribution"></label>
                        <input type="number" asp-for="BotJackpotContribution" class="form-control" />
                        <span asp-validation-for="BotJackpotContribution" class="text-danger"></span>
                    </div>

                    <div class="col-lg-4">
                        <label class="control-label" asp-for="PlayerJackpotContribution"></label>
                        <input type="number" asp-for="PlayerJackpotContribution" class="form-control" />
                        <span asp-validation-for="PlayerJackpotContribution" class="text-danger"></span>
                    </div>


                    <div class="col-lg-12">
                        <label class="control-label" asp-for="AllowedCurrency"></label>
                        <input type="text" asp-for="AllowedCurrency" class="form-control" />
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Bonus</legend>
                <div class="form-group row">
                    <div class="col-lg-8">
                        Note: Bonus = (random (from &nbsp; <b>Min</b> &nbsp; to &nbsp; <b>Max</b>) * Stake Level)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label class="control-label">Min</label>
                        <input type="number" asp-for="MinBonus" class="form-control common-field" />
                        <span asp-validation-for="MinBonus" class="text-danger"></span>
                    </div>

                    <div class="col-lg-6">
                        <label class="control-label">Max</label>
                        <input type="number" asp-for="MaxBonus" class="form-control common-field" />
                        <span asp-validation-for="MaxBonus" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>
            <br />
        </div>

        <div id="cascading-slots-config" class="slots-game" style="display:none;">
            <div class="form-group">
                <label asp-for="Mode" class="control-label"></label>
                <select asp-items="@Model.ModeItems" asp-for="Mode" class="form-control common-field"></select>
            </div>

            <div class="form-group row">
                <div class="col-lg-12">
                    <label asp-for="NumberOfIcons" class="control-label"></label>
                    <input type="number" asp-for="NumberOfIcons" class="form-control common-field" />
                </div>
            </div>

            <div class="form-group row">
                <div class="col-lg-4">
                    <label class="control-label" asp-for="BigWinRatio"></label>
                    <input type="number" asp-for="BigWinRatio" class="form-control common-field" />
                    <span asp-validation-for="BigWinRatio" class="text-danger"></span>
                </div>
                <div class="col-lg-4">
                    <label class="control-label" asp-for="MegaWinRatio"></label>
                    <input type="number" asp-for="MegaWinRatio" class="form-control common-field" />
                    <span asp-validation-for="MegaWinRatio" class="text-danger"></span>
                </div>
                <div class="col-lg-4">
                    <label class="control-label" asp-for="SuperWinRatio"></label>
                    <input type="number" asp-for="SuperWinRatio" class="form-control common-field" />
                    <span asp-validation-for="SuperWinRatio" class="text-danger"></span>
                </div>
            </div>

            <fieldset>
                <legend>Bet Levels</legend>
                <div class="form-group row">
                    @for (var i = 0; i < Model.BetLevels.Length; i++)
                    {
                        <div class="col-lg-2">
                            <label class="control-label">@($"Level {i + 1}")</label>
                            <input type="number" asp-for="@Model.BetLevels[i]" class="form-control" />
                        </div>
                    }
                </div>
            </fieldset>
            <fieldset>
                <legend>Multiplier (bet amount)</legend>
                <div class="form-group row">
                    <div class="col-lg-4">
                        <input type="number" asp-for="@Model.BetMultiplier" class="form-control" />
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Max win per round</legend>
                <div class="form-group row">
                    <div class="col-lg-4">
                        <input type="number" asp-for="@Model.MaxWinPerRound" class="form-control" />
                    </div>
                </div>
            </fieldset>
            <fieldset>
                <legend>Multiplier Bonus</legend>
                <div class="form-group row">
                    <div class="col-lg-8">
                        Note: Multiplier value = Random (from &nbsp; <b>Min</b> &nbsp; to &nbsp; <b>Max</b>)
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <label class="control-label">Min</label>
                        <input type="number" asp-for="MinMultiplierBonus" class="form-control common-field" />
                        <span asp-validation-for="MinMultiplierBonus" class="text-danger"></span>
                    </div>

                    <div class="col-lg-6">
                        <label class="control-label">Max</label>
                        <input type="number" asp-for="MaxMultiplierBonus" class="form-control common-field" />
                        <span asp-validation-for="MaxMultiplierBonus" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>
            <br />
        </div>

        <div class="form-group">
            <input type="submit" value="Submit" class="btn-submit" />
        </div>
    </form>
</div>