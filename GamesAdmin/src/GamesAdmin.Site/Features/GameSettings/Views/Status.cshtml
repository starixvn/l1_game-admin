@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model StatusViewModel;

@{
    ViewData["Title"] = "Game Status";
}
@section Styles {
    <link href="~/scss/pages/game-status.css" rel="stylesheet" />
}


<div class="col-md-12 col-lg-10 game-status">
    <form class="form" asp-action="UpdateDisableMessage" asp-controller="GameSettings" method="post">

        <div class="form-group">
            <input type="button" onclick="gameStatus.enable()" value="Enable" class="btn-add btn-enable" />
            <input type="button" formaction="Disable" value="Disable" class="btn-gray" />
        </div>

        <table id="status-tbl" class="table table-bordered">
            <thead>
                <tr>
                    <th class="col-check">&nbsp;</th>
                    <th>Name</th>
                    <th class="col-status">Status</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="checkbox" id="status-all" value="all" onclick="gameStatus.checkAll();" /></td>
                    <td>All</td>
                    <td>&nbsp;</td>
                    <td>
                        <textarea placeholder="Message to display" class="message"></textarea>
                        @*<input id="msg-all" type="text" placeholder="Message to display" onchange="gameStatus.updateAllMessage(this);" />*@
                    </td>
                </tr>
                @for (var index = 0; index < Model.GameList.Count; index++)
                {
                    <tr>
                        <td>
                            <input class="game-status-chk" type="checkbox" />
                            <input type="hidden" asp-for="@Model.GameList[index].Name" />
                        </td>
                        <td>@Model.GameList[index].DisplayName</td>
                        <td class="text-center">
                            <div class="toggle-button">
                                <input type="checkbox" class="checkbox" id="@Model.GameList[index].Name" onclick="gameStatus.toggle(this)" value="@Model.GameList[index].Name" asp-for="@Model.GameList[index].Enabled">
                                <div class="knobs">
                                    <span></span>
                                </div>
                                <div class="layer"></div>
                            </div>
                        </td>

                        <td>
                            <textarea placeholder="Message to display" class="message"></textarea>
                            @*<input type="text" asp-for="@Model.GameList[index].DisabledMessage" class="disabled-message" placeholder="Message to display" />*@
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @*<div class="form-group">
                <input type="button" value="Save" class="btn-submit" />
            </div>*@
    </form>
</div>


@section Scripts{
    <script src="~/js/game-status.js" asp-append-version="true"></script>
}

