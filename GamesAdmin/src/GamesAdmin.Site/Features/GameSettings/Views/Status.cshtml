@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model StatusViewModel;

@{
    ViewData["Title"] = "Game Status";
}
@section Styles {
    <link href="~/scss/pages/game-status.css" rel="stylesheet" asp-append-version="true" />
}


<div class="col-md-12 col-lg-10 game-status">
    <div class="list-actions">
        <input type="button" onclick="gameStatus.enable()" value="ENABLE" class="btn-add btn-enable" />
        <input type="button" onclick="gameStatus.disable()" value="DISABLE" class="btn-gray" />       
    </div>

    <div class="force-reload">
        <label><input type="checkbox" id="reload" /> Force users to reload</label>
    </div>

    <table id="status-tbl" class="table table-bordered">
        <thead>
            <tr>
                <th class="col-check">&nbsp;</th>
                <th>Name</th>
                <th class="col-status">Enabled</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="text-center"><input type="checkbox" id="status-all" value="all" onclick="gameStatus.checkAll();" /></td>
                <td>All</td>
                <td>&nbsp;</td>
                <td>
                    <form class="form" asp-action="UpdateAllDisabledMessage" asp-controller="GameSettings" method="post">
                        <textarea placeholder="Message to display" name="disabledMessage" class="message"></textarea>
                        <button class="btn-save"><i class="material-icons icon-save">done_outline</i></button>
                    </form>
                </td>
            </tr>
            @for (var index = 0; index < Model.GameList.Count; index++)
            {
                <tr>
                    <td class="text-center">
                        <input class="game-status-chk" type="checkbox"  onclick="gameStatus.uncheckAll();" value="@Model.GameList[index].Name" />
                        <input type="hidden" class="game-display-name" asp-for="@Model.GameList[index].DisplayName" />
                    </td>
                    <td>@Model.GameList[index].DisplayName</td>
                    <td class="text-center">@Model.GameList[index].StatusDisplay</td>
                    <td>
                        <div>
                            <label class="content-message">@Model.GameList[index].DisabledMessage</label>
                            <button class="btn-edit" onclick="gameStatus.showForm(this)"><i class="material-icons icon-edit">create</i></button>
                        </div>                        
                        <form class="form form-disabled-message" asp-action="UpdateDisabledMessage" asp-controller="GameSettings" method="post" style="display:none">
                            <textarea name="disabledMessage" asp-for="@Model.GameList[index].DisabledMessage" placeholder="Message to display" class="message"></textarea>
                            <input type="hidden" name="name" asp-for="@Model.GameList[index].Name" />
                            <button class="btn-save"><i class="material-icons icon-save">done_outline</i></button>
                        </form>

                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@section Scripts{
    <script src="~/js/game-status.min.js" asp-append-version="true"></script>
}

