@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model StatusViewModel;

@{
    ViewData["Title"] = "Game Status";
}
@section Styles {
    <link href="~/scss/pages/game-status.css" rel="stylesheet" />
    <link href="~/scss/pages/forecast.css" rel="stylesheet" />
}

<div class="row">
    <div class="col-md-10 col-lg-6 card">
        <form class="card-body form" asp-action="UpdateDisableMessage" asp-controller="GameSettings" method="post">

            <div class="form-group">
                <input type="button" onclick="gameStatus.enable()" value="Enable" class="btn-submit" />
                <input type="button" formaction="Disable" value="Disable" class="btn-submit" />
            </div>

            <table id="status-tbl" class="table">
                <thead>
                    <tr>
                        <th>&nbsp;</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><input type="checkbox" id="status-all" value="all" onclick="gameStatus.checkAll();" /></td>
                        <td>All</td>
                        <td>&nbsp;</td>
                        <td><input id="msg-all" type="text" placeholder="Message to display" onchange="gameStatus.updateAllMessage(this);"  /></td>
                    </tr>
                    @for(var index = 0; index < Model.GameList.Count; index++)
                    {
                        <tr>
                            <td>
                                <input class="game-status-chk" type="checkbox" />
                                <input type="hidden" asp-for="@Model.GameList[index].Name" />
                            </td>
                            <td>@Model.GameList[index].DisplayName</td>
                            <td>
                                <div class="toggle-switch">
                                    <input type="checkbox" id="@Model.GameList[index].Name" onclick="gameStatus.toggle(this)" value="@Model.GameList[index].Name" asp-for="@Model.GameList[index].Enabled">
                                    <label for="@Model.GameList[index].Name">
                                        <span class="toggle-track"></span>
                                    </label>
                                </div>
                            </td>

                            <td><input type="text" asp-for="@Model.GameList[index].DisabledMessage" class="disabled-message" placeholder="Message to display" /> </td>
                        </tr>
                    }
                </tbody>
            </table>

            @*<div class="form-group">
                <input type="button" value="Save" class="btn-submit" />
            </div>*@
        </form>
    </div>
</div>


@section Scripts{
    <script src="~/js/game-status.js" asp-append-version="true"></script>
}

