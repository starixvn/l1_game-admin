@{ Layout = null; }

@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model SuperPlayersViewModel;

@{
    ViewData["Title"] = "Update Super Players";
}

<div>
    <form class="card-body form" asp-action="SuperPlayers" asp-controller="GameSettings" method="post" id="super-players-form">
        <div id="super-players-msg-container" class="form-group row" style="display: none">
            <div class="message-success hidden-cls" id="update-super-players-success"><i class="icon-check"></i><span>Updated successfully</span></div>
            <div class="message-error hidden-cls" id="update-super-players-failed"><i class="icon-cancel"></i><span>Error</span></div>
        </div>
        <div class="form-group row">
            <label class="control-label">Super Players</label>
            <textarea rows="3" cols="50" id="super-players-names" placeholder="Names are separated by ';'"
                      style="height: 223px;"
                      asp-for="SuperPlayers" class="form-control" value="@Model.SuperPlayers"></textarea>
        </div>
    </form>
</div>
