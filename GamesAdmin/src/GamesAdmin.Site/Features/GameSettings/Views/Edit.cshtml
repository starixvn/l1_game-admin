@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model EditViewModel;

@{
    ViewData["Title"] = Model.DisplayName;
}
<div class="row">

    <div class="col-md-10 col-lg-6 card">
        @if (Model.Success)
        {
            <div class="message-success"><i class="material-icons">check_circle</i> Updated successfully</div>
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(@Model.ErrorMessage))
            {
                <div class="message-error"><i class="material-icons">cancel</i> @Model.ErrorMessage</div>
            }

            <form class="card-body form-add" asp-action="Update" asp-controller="GameSettings" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group row">
                    <div class="col-lg-6">
                        <label asp-for="MinBet" class="control-label"></label>
                        <input type="number" asp-for="MinBet" class="form-control" />
                        <span asp-validation-for="MinBet" class="text-danger"></span>
                        <input asp-for="Name" type="hidden" class="form-control" />
                        <input asp-for="Id" type="hidden" class="form-control" />
                    </div>
                    <div class="col-lg-6">
                        <label asp-for="MaxBet" class="control-label"></label>
                        <input type="number" asp-for="MaxBet" class="form-control" />
                        <span asp-validation-for="MaxBet" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div>
                        <input type="checkbox" asp-for="Enabled" />
                        <label asp-for="Enabled" class="control-label"></label>
                    </div>
                    <span asp-validation-for="Enabled" class="text-danger"></span>
                </div>

                <hr />

                @*<div class="form-group">
                        <label asp-for="BotMinBet" class="control-label"></label>
                        <input type="number" asp-for="BotMinBet" class="form-control" />
                        <span asp-validation-for="BotMinBet" class="text-danger"></span>
                    </div>*@

                <div class="form-group">
                    <label asp-for="BotMaxBet" class="control-label"></label>
                    <input type="number" asp-for="BotMaxBet" class="form-control" />
                    <span asp-validation-for="BotMaxBet" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaxBot" class="control-label"></label>
                    <select asp-items="@Model.BotPercentageItems" asp-for="MaxBot" class="form-control"></select>
                    <span> <i>(Current bots: <b><label id="CurrentBot">@Model.CurrentBot</label></b>/<label id="BotCount">@Model.BotCount</label>)</i></span>
                    <span>
                        <a id="OpenDialog" href="#" data-toggle="modal" data-target="#exampleModal">Adjust bots by hour</a>

                    </span>
                </div>

                <div class="form-group">
                    <div>
                        <input type="checkbox" asp-for="BotEnabled" />
                        <label asp-for="BotEnabled" class="control-label"></label>
                    </div>
                    <span asp-validation-for="BotEnabled" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Update" class="btn-submit" />
                </div>
            </form>
        }
    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    ...
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save changes</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript" src="~/js/GameSettings.js"></script>
}
