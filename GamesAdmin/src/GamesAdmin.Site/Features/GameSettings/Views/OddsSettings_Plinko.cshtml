@{
    Layout = null;
}

@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model EditViewModel;

@{
    var gameModes = new [] { "low", "medium", "high" };
    const string lightning = "lightning";
}

<div>
    <ul class="nav nav-custom" id="plinko-setting-tabs">
        @foreach(var gameMode in gameModes)
        {
            var capitalizedLevel = char.ToUpper(gameMode[0]) + gameMode.Substring(1);
            var activeClass = gameMode == "low" ? " active" : "";

            <li class="nav-item">
                <button type="button" class="nav-link @activeClass" id="@gameMode-tab-header" onclick="gameStatus.togglePlinkoSettingTabs('@gameMode')">@capitalizedLevel</button>
            </li>
            
        }
        <li class="nav-item">
            <button type="button" class="nav-link" id="@lightning-tab-header" onclick="gameStatus.togglePlinkoSettingTabs('@lightning')">Lightning</button>
        </li>
    </ul>

    <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Updated successfully</span></div>
    <div class="message-error hidden-cls" id="failedMsg"><i class="icon-cancel"></i><span>Error</span></div>

    <form class="form-group row">
        <div id="plinkoConfig">Game Name: @Model.Name</div>
        <input type="hidden" asp-for="@Model.Name" />
        
        <div class="tab-content">
            <!-- Risk Level Tabs -->
            @for (var index = 0; index < gameModes.Length; index++)
            {
                var gameMode = gameModes[index];
                var gameModeOdds = Model.PlinkoConfig.Odds[index.ToString()];
                var activeClass = index == 0 ? "tab-pane active" : "tab-pane";

                <div id=@gameMode class="@activeClass">
                    <div class="form-group">
                        <label class="control-label">
                            Mirror Values (slot <->
                                row - slot)
                                <input type="checkbox" id="mirror-@gameMode" checked onchange="gameStatus.toggleMirrorValues('@gameMode')" />
                        </label>
                    </div>
                    <div class="form-group">
                        <div class="control-label">Mode @(char.ToUpperInvariant(gameMode[0]) + gameMode.Substring(1)) Average RTP: <span id="average-rtp-@gameMode"></span>%</div>
                    </div>
                    @foreach (var i in gameModeOdds)
                    {
                        var odds = i.Value;
                        <div class="col-lg-12 mb-3">
                            <fieldset>
                                <legend>Row @i.Key</legend>
                                <div class="form-group row">
                                    <div class="col-md-11 row">
                                        @for (int j = 0; j < odds.Length; j++)
                                        {
                                            <div class="col-md-2 mb-2">
                                                <label class="control-label">
                                                    Slot @j
                                                    <input type="number" asp-for="@Model.PlinkoConfig.Odds[index.ToString()][i.Key][j]" class="form-control pl-2" />
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-1 mb-2">
                                        <div class="control-label">
                                            Estimated RTP (%)
                                            <div id="rtp-@gameMode-@i.Key" class="form-control" readonly style="background-color: #f8f9fa; border: 1px solid #ced4da; padding: 0.375rem 0.75rem; min-height: 38px; display: inline-block; align-items: center; width: fit-content"></div>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    }
                </div>
            }

            <!-- Lightning Tab -->
            <div id="lightning" class="tab-pane">
                <div class="form-group m-3">
                    <label class="control-label">
                        Enabled Lightning Mode
                        <input type="checkbox" asp-for="PlinkoConfig.EnabledLightningMode" />
                    </label>
                </div>
            </div>
        </div>
    </form>
</div>