@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@model EditViewModel;

<div>
    <ul class="nav nav-custom" id="setting-tabs">
        <li class="nav-item">
            <a class="nav-link active" id="general-tab-header" href="#" onclick="gameStatus.toggleSettingTabs('general')">General</a>
        </li>
    </ul>

    <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Updated successfully</span></div>
    <div class="message-error hidden-cls" id="failedMsg"><i class="icon-cancel"></i><span>Error</span></div>

    <form class="card-body form" asp-action="Update" asp-controller="GameSettings" method="post" id="gameForm">

        <div id="general">
            <div class="form-group row">
                <div class="col-lg-6">
                    Game Status: <strong>@Model.StatusDisplay</strong>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="@Model.SlotViewModel.Mode" class="control-label"></label>
                <select asp-items="@Model.SlotViewModel.ModeItems" asp-for="@Model.SlotViewModel.Mode" class="form-control"></select>
            </div>

            <fieldset>
                <legend>Multiplier Bonus</legend>
                <div class="form-group row">
                    <div class="col-lg-8">
                        Note: Multiplier Bonus = random (from &nbsp; <b>Min</b> &nbsp; to &nbsp; <b>Max</b>)
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-lg-6">
                        <label class="control-label">Min</label>
                        <input type="number" asp-for="@Model.SlotViewModel.MinBonus" class="form-control" />
                        <span asp-validation-for="@Model.SlotViewModel.MinBonus" class="text-danger"></span>
                    </div>

                    <div class="col-lg-6">
                        <label class="control-label">Max</label>
                        <input type="number" asp-for="@Model.SlotViewModel.MaxBonus" class="form-control" />
                        <span asp-validation-for="@Model.SlotViewModel.MaxBonus" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>
            <br />

            <fieldset>
                <legend>Bet Levels</legend>
                <div class="form-group row">
                    @for (var i = 0; i < Model.SlotsConfig.BetLevels.Length; i++)
                    {
                        <div class="col-lg-2">
                            <label class="control-label">@($"Level {i + 1}")</label>
                            <input type="number" asp-for="@Model.SlotsConfig.BetLevels[i]" class="form-control txt-bet-level @(Model.SlotsConfig.BetLevels[i] == 0 ? "" :"disabled")" disabled="@(Model.SlotsConfig.BetLevels[i] != 0)" />
                        </div>
                    }
                </div>
            </fieldset>
            <fieldset>
                <legend>Multiplier for bet amount</legend>
                <div class="form-group row">
                    <div class="col-lg-6">
                        <input type="number" asp-for="@Model.SlotViewModel.Multiplier" class="form-control" />
                        <span asp-validation-for="@Model.SlotViewModel.Multiplier" class="text-danger"></span>
                    </div>
                </div>
            </fieldset>
            <br />
            <div class="form-group">
                <label asp-for="@Model.SlotViewModel.BigWinRatio" class="control-label"></label>
                <input type="number" asp-for="@Model.SlotViewModel.BigWinRatio" class="form-control" />
            </div>

            <div class="form-group">
                <input type="checkbox" asp-for="BotEnabled" />
                <label asp-for="BotEnabled" class="control-label"></label>
            </div>
        </div>

        <div id="botsetting" style="display:none">
            <input asp-for="Name" type="hidden" class="form-control" />
            <input asp-for="Type" type="hidden" class="form-control" />

            @if (Model.PayoutViewModel.DisplayMaxBetChoices)
            {
                <fieldset>
                    <legend>Bet Choices</legend>
                    @for (var i = 0; i < (Model.PayoutViewModel.BetChoiceBetSettings.Count / 2 + 1); i++)
                    {
                        <div class="form-group row">
                            @for (var j = 0; j < 2; j++)
                            {
                                var index = i * 2 + j;
                                if (index < Model.PayoutViewModel.BetChoiceBetSettings.Count)
                                {
                                    <div class="col-lg-6">
                                        <label class="control-label">@Model.PayoutViewModel.BetChoiceBetSettings[index].DisplayName</label>
                                        <input type="text" hidden asp-for="@Model.PayoutViewModel.BetChoiceBetSettings[index].Name" class="form-control" />
                                        <input type="number" asp-for="@Model.PayoutViewModel.BetChoiceBetSettings[index].MaxBet" class="form-control" />
                                    </div>
                                }
                            }
                        </div>
                    }
                </fieldset>
            }

            <br />
        </div>
    </form>
</div> 