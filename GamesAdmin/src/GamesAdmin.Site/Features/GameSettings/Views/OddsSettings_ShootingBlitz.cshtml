@{
    Layout = null;
}

@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@using Newtonsoft.Json;
@model EditViewModel;

<div class="shooting-blitz-odds">
    <input type="hidden" id="gameName" value="@Model.Name" />
    
    <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Updated successfully</span></div>
    <div class="message-error hidden-cls" id="failedMsg"><i class="icon-cancel"></i><span>Error</span></div>
    
    <!-- Current RTP Selection -->
    <div class="card mb-3">
        <div class="card-header">
            <h5 class="mb-0">Current RTP Configuration</h5>
        </div>
        <div class="card-body">
            <div class="form-group row">
                <label class="col-sm-3 col-form-label">Selected RTP Config</label>
                <div class="col-sm-6">
                    <select class="form-control" id="selectedRtpConfig">
                        <option value="">-- Select RTP Config --</option>
                        @if (Model.ShootingBlitzRtpConfigs != null)
                        {
                            @foreach (var rtpConfig in Model.ShootingBlitzRtpConfigs)
                            {
                                var isSelected = Model.ShootingBlitzConfig?.RtpConfigId == rtpConfig.Id;
                                if (isSelected)
                                {
                                    <option value="@rtpConfig.Id" selected="selected">RTP @(rtpConfig.Rtp * 100)%</option>
                                }
                                else
                                {
                                    <option value="@rtpConfig.Id">RTP @(rtpConfig.Rtp * 100)%</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <button type="button" class="btn btn-primary" onclick="shootingBlitzOdds.applyRtpSelection()">
                        <i class="icon-check"></i> Apply Selection
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- RTP Config List -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">RTP Config List</h5>
            <button type="button" class="btn btn-primary btn-sm" onclick="shootingBlitzOdds.showCreateRtpModal()">
                <i class="icon-plus"></i> Create New RTP Config
            </button>
        </div>
        <div class="card-body">
            <table class="table table-striped" id="rtpConfigTable">
                <thead>
                    <tr>
                        <th>RTP</th>
                        <th>Bomb Count Rules</th>
                        <th>Multiplier Steps</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ShootingBlitzRtpConfigs != null)
                    {
                        @foreach (var rtpConfig in Model.ShootingBlitzRtpConfigs)
                        {
                            var isCurrentlySelected = Model.ShootingBlitzConfig?.RtpConfigId == rtpConfig.Id;
                            <tr data-id="@rtpConfig.Id" class="@(isCurrentlySelected ? "table-success" : "")">
                                <td>
                                    @(rtpConfig.Rtp * 100)%
                                    @if (isCurrentlySelected)
                                    {
                                        <span class="badge badge-success ml-2">Current</span>
                                    }
                                </td>
                                <td>@(rtpConfig.BombCount?.Count ?? 0) rules</td>
                                <td>@(rtpConfig.MultiplierSteps?.Count ?? 0) modes</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-info" onclick="shootingBlitzOdds.editRtpConfig('@rtpConfig.Id')">
                                        <i class="icon-edit"></i> Edit
                                    </button>
                                    <button type="button" class="btn btn-sm btn-danger" onclick="shootingBlitzOdds.deleteRtpConfig('@rtpConfig.Id')">
                                        <i class="icon-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- RTP Config Modal -->
<div class="modal fade" id="rtpConfigModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rtpConfigModalTitle">Create RTP Config</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="rtpConfigForm">
                    <input type="hidden" id="rtpConfigId" />
                    
                    <div class="form-group">
                        <label>RTP (0-1)</label>
                        <input type="number" step="0.01" min="0" max="1" class="form-control" id="rtpValue" required />
                    </div>
                    
                    <fieldset class="border p-3 mb-3">
                        <legend class="w-auto">Bomb Count Configuration</legend>
                        <div id="bombCountContainer"></div>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="shootingBlitzOdds.addBombCountRow()">
                            <i class="icon-plus"></i> Add Bomb Count
                        </button>
                        <div class="mt-2">
                            <strong>Probability Sum: <span id="probabilitySum">0</span></strong>
                        </div>
                    </fieldset>
                    
                    <fieldset class="border p-3 mb-3">
                        <legend class="w-auto">Multiplier Steps</legend>
                        <ul class="nav nav-tabs" id="multiplierStepsTabs"></ul>
                        <div class="tab-content p-3 border border-top-0" id="multiplierStepsContent"></div>
                        <button type="button" class="btn btn-secondary btn-sm mt-2" onclick="shootingBlitzOdds.addMultiplierMode()">
                            <i class="icon-plus"></i> Add Mode
                        </button>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="shootingBlitzOdds.saveRtpConfig()">Save</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="rtpConfigsData" value='@Html.Raw(JsonConvert.SerializeObject(Model.ShootingBlitzRtpConfigs ?? new List<GamesAdmin.Core.Models.GameConfigs.ShootingBlitzRtpConfig>()))' />
<input type="hidden" id="currentRtpConfigId" value="@(Model.ShootingBlitzConfig?.RtpConfigId ?? "")" />

<script src="/js/shooting-blitz-odds.js"></script>

