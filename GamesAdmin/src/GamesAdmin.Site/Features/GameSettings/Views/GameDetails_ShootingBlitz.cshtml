@using GamesAdmin.Core.Enumeration;
@using GamesAdmin.Core;
@using GamesAdmin.Site.Features.GameSettings.ViewModels;
@using Newtonsoft.Json;

@inject GamesAdmin.Site._Shared.Configurations.ISystemSettings systemSettings;

@model EditViewModel;
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine ViewEngine

<div>
    <ul class="nav nav-custom" id="setting-tabs">
        <li class="nav-item">
            <button class="nav-link active" id="general-tab-header" href="#" onclick="shootingBlitz.toggleSettingTabs('general')">General</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="teams-tab-header" href="#" onclick="shootingBlitz.toggleSettingTabs('teams')">Teams</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="rtp-tab-header" href="#" onclick="shootingBlitz.toggleSettingTabs('rtp')">RTP</button>
        </li>
    </ul>

    <div class="message-success hidden-cls" id="successMsg"><i class="icon-check"></i><span>Updated successfully</span></div>
    <div class="message-error hidden-cls" id="failedMsg"><i class="icon-cancel"></i><span>Error</span></div>

    <form class="card-body form" asp-action="Update" asp-controller="GameSettings" method="post" id="gameForm">
        <input hidden asp-for="GameId" />
        <input hidden asp-for="Name" />
        <input hidden asp-for="Type" />

        <!-- General Tab -->
        <div id="general">
            <div class="form-group row">
                <div class="col-lg-6">
                    Game Status: <strong>@Model.StatusDisplay</strong>
                </div>
                <div class="col-lg-6">
                    Game Type: <strong>@Model.TypeDisplay</strong>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-lg-6">
                    <label asp-for="EnableFreeBet" class="control-label">
                        <input type="checkbox" asp-for="EnableFreeBet" />
                        Enable Free Bet
                    </label>
                </div>
                <div class="col-lg-6">
                    <label class="control-label">
                        <input type="checkbox" id="UseLiveScore" name="ShootingBlitzConfig.UseLiveScore" 
                               @(Model.ShootingBlitzConfig?.UseLiveScore == true ? "checked" : "") />
                        Use Live Score
                    </label>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-lg-6">
                    <label asp-for="DelayStartTime" class="control-label">
                        Delay Start Time
                        <input type="number" asp-for="DelayStartTime" class="form-control" />
                    </label>
                </div>
                <div class="col-lg-6">
                    <label asp-for="BotMaxBet" class="control-label">
                        Bot Max Bet
                        <input type="number" asp-for="BotMaxBet" class="form-control" />
                    </label>
                </div>
            </div>

            <div class="form-group row">
                <div class="col-lg-6">
                    <label asp-for="BotEnabled" class="control-label">
                        <input type="checkbox" asp-for="BotEnabled" />
                        Bot Enabled
                    </label>
                </div>
            </div>
        </div>
    </form>

    <!-- Teams Tab -->
    <div id="teams" style="display:none">
        <div class="mb-3">
            <button type="button" class="btn btn-primary" onclick="shootingBlitz.showCreateTeamModal()">
                <i class="icon-plus"></i> Create New Team
            </button>
        </div>
        
        <table class="table table-striped" id="teamsTable">
            <thead>
                <tr>
                    <th>Team ID</th>
                    <th>Team Name</th>
                    <th>Player Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ShootingBlitzTeams != null)
                {
                    @foreach (var team in Model.ShootingBlitzTeams)
                    {
                        <tr data-id="@team.Id">
                            <td>@team.TeamId</td>
                            <td>@team.Name</td>
                            <td>@(team.PlayerList?.Count ?? 0)</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-info" onclick="shootingBlitz.editTeam('@team.Id')">
                                    <i class="icon-edit"></i> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="shootingBlitz.deleteTeam('@team.Id')">
                                    <i class="icon-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- RTP Tab -->
    <div id="rtp-tab-content" style="display:none">
        <input type="hidden" id="gameName" value="@Model.Name" />
        
        <!-- Current RTP Selection -->
        <div class="card mb-3">
            <div class="card-header">
                <h5 class="mb-0">Current RTP Configuration</h5>
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <label class="col-sm-3 col-form-label">Selected RTP Config</label>
                    <div class="col-sm-6">
                        <select class="form-control" id="selectedRtpConfig">
                            <option value="">-- Select RTP Config --</option>
                            @if (Model.ShootingBlitzRtpConfigs != null)
                            {
                                @foreach (var rtpConfig in Model.ShootingBlitzRtpConfigs)
                                {
                                    var isSelected = Model.ShootingBlitzConfig?.RtpConfigId == rtpConfig.Id;
                                    if (isSelected)
                                    {
                                        <option value="@rtpConfig.Id" selected="selected">RTP @(rtpConfig.Rtp * 100)%</option>
                                    }
                                    else
                                    {
                                        <option value="@rtpConfig.Id">RTP @(rtpConfig.Rtp * 100)%</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="button" class="btn btn-primary" onclick="shootingBlitzRtp.applyRtpSelection()">
                            <i class="icon-check"></i> Apply Selection
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- RTP Config List -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">RTP Config List</h5>
                <button type="button" class="btn btn-primary btn-sm" onclick="shootingBlitzRtp.showCreateRtpModal()">
                    <i class="icon-plus"></i> Create New RTP Config
                </button>
            </div>
            <div class="card-body">
                <table class="table table-striped" id="rtpConfigTable">
                    <thead>
                        <tr>
                            <th>RTP</th>
                            <th>Multiplier Steps</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ShootingBlitzRtpConfigs != null)
                        {
                            @foreach (var rtpConfig in Model.ShootingBlitzRtpConfigs)
                            {
                                var isCurrentlySelected = Model.ShootingBlitzConfig?.RtpConfigId == rtpConfig.Id;
                                <tr data-id="@rtpConfig.Id" class="@(isCurrentlySelected ? "table-success" : "")">
                                    <td>
                                        @(rtpConfig.Rtp * 100)%
                                        @if (isCurrentlySelected)
                                        {
                                            <span class="badge badge-success ml-2">Current</span>
                                        }
                                    </td>
                                    <td>@(rtpConfig.MultiplierSteps?.Count ?? 0) modes</td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-info" onclick="shootingBlitzRtp.editRtpConfig('@rtpConfig.Id')">
                                            <i class="icon-edit"></i> Edit
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="shootingBlitzRtp.deleteRtpConfig('@rtpConfig.Id')">
                                            <i class="icon-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Team Modal -->
<div class="modal fade" id="teamModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="teamModalTitle">Create Team</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="teamForm">
                    <input type="hidden" id="teamDbId" />
                    
                    <div class="form-group row">
                        <div class="col-6">
                            <label>Team ID</label>
                            <input type="number" class="form-control" id="teamId" required />
                        </div>
                        <div class="col-6">
                            <label>Team Name</label>
                            <input type="text" class="form-control" id="teamName" required />
                        </div>
                    </div>
                    
                    <fieldset class="border p-3 mb-3">
                        <legend class="w-auto">Player List</legend>
                        <div id="playerListContainer"></div>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="shootingBlitz.addPlayerRow()">
                            <i class="icon-plus"></i> Add Player
                        </button>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="shootingBlitz.saveTeam()">Save</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="teamsData" value='@Html.Raw(JsonConvert.SerializeObject(Model.ShootingBlitzTeams ?? new List<GamesAdmin.Core.Models.GameConfigs.ShootingBlitzTeam>()))' />

<!-- RTP Config Modal -->
<div class="modal fade" id="rtpConfigModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rtpConfigModalTitle">Create RTP Config</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="rtpConfigForm">
                    <input type="hidden" id="rtpConfigId" />
                    
                    <div class="form-group">
                        <label>RTP (0-1)</label>
                        <input type="number" step="0.01" min="0" max="1" class="form-control" id="rtpValue" required />
                    </div>
                    
                    <fieldset class="border p-3 mb-3">
                        <legend class="w-auto">Multiplier Steps</legend>
                        <ul class="nav nav-tabs" id="multiplierStepsTabs"></ul>
                        <div class="tab-content p-3 border border-top-0" id="multiplierStepsContent"></div>
                        <button type="button" class="btn btn-secondary btn-sm mt-2" onclick="shootingBlitzRtp.addMultiplierMode()">
                            <i class="icon-plus"></i> Add Mode
                        </button>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="shootingBlitzRtp.saveRtpConfig()">Save</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="rtpConfigsData" value='@Html.Raw(JsonConvert.SerializeObject(Model.ShootingBlitzRtpConfigs ?? new List<GamesAdmin.Core.Models.GameConfigs.ShootingBlitzRtpConfig>(), new JsonSerializerSettings { ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver() }))' />
<input type="hidden" id="currentRtpConfigId" value="@(Model.ShootingBlitzConfig?.RtpConfigId ?? "")" />

<script src="/js/shooting-blitz-general.js"></script>
<script src="/js/shooting-blitz-rtp.js"></script>
