@model GamesAdmin.Site.Features.PlayerChainResultsManagement.ViewModels.IndexViewModel
@{
    ViewData["Title"] = "Player Chains Management";
}

@section Styles {
    <link rel="stylesheet" type="text/css" href="~/lib/data-tables/datatables.min.css">
    <link rel="stylesheet" href="~/css/player-chain-results.min.css" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <!-- Filter Section -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-group" style="margin-bottom: 0px; !important">
                                <label for="gameIdFilter">Game ID:</label>
                                <input type="text" class="form-control" id="gameIdFilter" placeholder="Enter Game ID"
                                    value="@Model.GameId">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group" style="margin-bottom: 0px; !important">
                                <label for="playerIdFilter">Player ID:</label>
                                <input type="text" class="form-control" id="playerIdFilter"
                                    placeholder="Enter Player ID" value="@Model.PlayerId">
                            </div>
                        </div>
                        <div class="col-md-6 d-flex flex-column">
                            <div id="filterButtons" class="d-flex mt-auto">
                                <button type="button" class="btn btn-primary mr-2" id="applyFilters">
                                    Search
                                </button>
                                <button type="button" class="btn btn-secondary mr-2" id="clearFilters">
                                    Clear
                                </button>
                                <button type="button" class="btn btn-success" id="exportButton">
                                    Export
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover" id="playerChainResultsTable">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Player ID</th>
                                    <th>Player Name</th>
                                    <th>Operator ID</th>
                                    <th>Game ID</th>
                                    <th style="width: 150px;">Chain Name</th>
                                    <th>Current/Total Board</th>
                                    <th>Currency</th>
                                    <th>Assigned At (GMT+7)</th>
                                    <th>Completed At (GMT+7)</th>
                                    <th>Status</th>
                                    <th>Bet Level</th>
                                    <th>Coin Value</th>
                                    <th>Total Win Amount</th>
                                    <th>Total Bet Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Results != null && Model.Results.Any())
                                {
                                    @foreach (var result in Model.Results)
                                    {
                                        <tr>
                                            <td style="text-align: center;" class="truncate-cell" data-full-text="@result.PlayerId">@result.PlayerId</td>
                                            <td style="text-align: center;" class="truncate-cell" data-full-text="@result.PlayerName">
                                                @result.PlayerName
                                            </td>
                                            <td style="text-align: center;">@result.OperatorId</td>
                                            <td style="text-align: center;">@result.GameId</td>
                                            <td class="truncate-cell" data-full-text="@result.ChainName" data-copy-value="@result.ChainName">
                                                <div class="chain-name-cell">@result.ChainName</div>
                                                <div class="copy-label">Copy</div>
                                            </td>
                                            <td style="text-align: center;">@result.CurrentBoardIndex/@result.TotalBoards</td>
                                            <td style="text-align: center;">@result.Currency</td>
                                            <td style="text-align: center;">@result.AssignedAt.ToString("yyyy-MM-dd HH:mm:ss")
                                            <td style="text-align: center;">@(result.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>
                                            <td style="text-align: center;">
                                                @{
                                                    var badgeClass = result.Status switch
                                                    {
                                                        "completed" => "badge-success",
                                                        "active" => "badge-primary",
                                                        "inactive" => "badge-secondary",
                                                        _ => "badge-secondary"
                                                    };
                                                }
                                                <span class="badge @badgeClass">@result.Status</span>
                                            </td>
                                            <td style="text-align: center;">@result.BetLevel</td>
                                            <td style="text-align: center;">@result.CoinValue</td>
                                            <td class="text-success font-weight-bold" style="text-align: center;">
                                                @result.TotalWinAmount
                                            </td>
                                            <td class="text-danger font-weight-bold" style="text-align: center;">
                                                @result.TotalBetAmount
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="16" class="text-center">No data available</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- Pagination and Info Section -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <span class="text-muted mr-3">
                                    Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to
                                    @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords)) of
                                    @Model.TotalRecords entries
                                </span>
                                <div class="d-flex align-items-center">
                                    <label for="pageSizeSelect" class="mb-0 mr-2 text-muted">Page Size:</label>
                                    <select class="form-control form-control-sm" id="pageSizeSelect"
                                        style="width: 80px;">
                                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        @if (Model.TotalPages > 1)
                        {
                            <div class="col-md-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-end mb-0">
                                        @if (Model.CurrentPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="@Url.Action("Index", "PlayerChainResultsManagement", new { gameId = Model.GameId, playerId = Model.PlayerId, page = 1, pageSize = Model.PageSize })">First</a>
                                            </li>
                                        }

                                        @if (Model.CurrentPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="@Url.Action("Index", "PlayerChainResultsManagement", new { gameId = Model.GameId, playerId = Model.PlayerId, page = Model.CurrentPage - 1, pageSize = Model.PageSize })">Previous</a>
                                            </li>
                                        }

                                        @{
                                            int startPage = Math.Max(1, Model.CurrentPage - 2);
                                            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                                        }

                                        @for (int i = startPage; i <= endPage; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link"
                                                    href="@Url.Action("Index", "PlayerChainResultsManagement", new { gameId = Model.GameId, playerId = Model.PlayerId, page = i, pageSize = Model.PageSize })">@i</a>
                                            </li>
                                        }

                                        @if (Model.CurrentPage < Model.TotalPages)
                                        {
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="@Url.Action("Index", "PlayerChainResultsManagement", new { gameId = Model.GameId, playerId = Model.PlayerId, page = Model.CurrentPage + 1, pageSize = Model.PageSize })">Next</a>
                                            </li>
                                        }

                                        @if (Model.CurrentPage < Model.TotalPages)
                                        {
                                            <li class="page-item">
                                                <a class="page-link"
                                                    href="@Url.Action("Index", "PlayerChainResultsManagement", new { gameId = Model.GameId, playerId = Model.PlayerId, page = Model.TotalPages, pageSize = Model.PageSize })">Last</a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <environment include="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.js"></script>
        <script src="~/js/player-chain-results.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery-unobtrusive-ajax/jquery.unobtrusive-ajax.min.js"></script>
        <script type="text/javascript" src="~/lib/data-tables/datatables.min.js"></script>
        <script src="~/js/player-chain-results.min.js"></script>
    </environment>
}