@{ Layout = null; }

@using GamesAdmin.Site.Features.GameUsers.ViewModels;
@model UpdateSpinViewModel;

@{
    ViewData["Title"] = "Member Spins";
}

<div class="col-md-12 col-lg-6 card">
    <form class="card-body form-add form" id="updateSpin" asp-action="UpdateSpin" asp-controller="GameUser" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="AvailSpins" class="control-label"></label>
            <input type="number" asp-for="AvailSpins" />
            <input type="hidden" asp-for="MemberId" />
            <span asp-validation-for="AvailSpins" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ExpiryDate" class="control-label"></label>
            <input type="datetime" asp-for="ExpiryDate" class="form-control" />
            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <input type="submit" value="Submit" class="btn-submit" />
        </div>
    </form>
</div>

